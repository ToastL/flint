// The repository's build tool, started by ./x (which finds the compiler that runs it):
//
//   stages.fl  building the compiler with itself, and the fixpoint check
//   tests.fl   the test runner
//   dist.fl    release tarballs, install and uninstall
//   sys.fl     files, directories and running programs
//
// It's compiled by stage 0, so like the compiler it may only use what the release pinned in
// bootstrap/release supports.

import std.io;
import std.process;
import sys;
import stages;
import tests;
import dist;

let USAGE: []const u8 = "usage: ./x [command] [options]\n  build              stage 0 builds build/stage1/flint, which builds build/flint (the default)\n  test [filter]      builds, then runs the tests (only those whose name contains filter)\n  check              builds, then checks that build/flint rebuilds itself to the same assembly\n  ci                 build, check and test\n  dist               builds, then packs build/dist/flint-<version>-<arch>-<os>.tar.gz\n  install            builds, then installs flint into $DESTDIR$PREFIX/bin (PREFIX: /usr/local)\n  uninstall          removes it from there\n  clean              removes build/\noptions:\n  -O mode            the mode the compiler is built in: Debug, ReleaseSafe (default), ReleaseFast\n  --flint path       test: the compiler to test, instead of building build/flint\nstage 0 is the release pinned in bootstrap/release, or FLINT_BOOTSTRAP=path/to/flint\n";

fn usage(problem: []const u8) -> u8 {
    _ = io.eprint("{s}{s}", .{problem, USAGE}) catch {};
    return 2;
}

fn main() -> u8 {
    let argv = args();
    var cmd: []const u8 = "build";
    var mode: []const u8 = "ReleaseSafe";
    var compiler: []const u8 = process.getEnv("FLINT") orelse "";
    var filter: []const u8 = "";
    var i: usize = 1;
    if (argv.len > 1 && argv[1].len > 0 && argv[1][0] != '-') {
        cmd = argv[1];
        i = 2;
    }
    let is_test = sys.eq(cmd, "test");
    while (i < argv.len) {
        let a = argv[i];
        if (sys.eq(a, "-O") && i + 1 < argv.len) {
            i += 1;
            mode = argv[i];
            if (!sys.eq(mode, "Debug") && !sys.eq(mode, "ReleaseSafe") && !sys.eq(mode, "ReleaseFast")) {
                return usage(sys.f("x: unknown build mode '{s}'\n", .{mode}));
            }
        } else if (sys.eq(a, "--flint") && i + 1 < argv.len && is_test) {
            i += 1;
            compiler = argv[i];
        } else if (is_test && filter.len == 0 && a.len > 0 && a[0] != '-') {
            filter = a;
        } else {
            return usage(sys.f("x: unexpected argument '{s}'\n", .{a}));
        }
        i += 1;
    }
    var status: u8 = 0;
    if (sys.eq(cmd, "build")) {
        stages.build(mode, false);
    } else if (is_test) {
        if (compiler.len == 0) {
            stages.build(mode, true);
            compiler = stages.FLINT;
        }
        status = tests.run(compiler, filter);
    } else if (sys.eq(cmd, "check")) {
        stages.check(mode);
    } else if (sys.eq(cmd, "ci")) {
        stages.check(mode);
        status = tests.run(stages.FLINT, "");
    } else if (sys.eq(cmd, "dist")) {
        stages.build(mode, true);
        dist.dist();
    } else if (sys.eq(cmd, "install")) {
        stages.build(mode, true);
        dist.install();
    } else if (sys.eq(cmd, "uninstall")) {
        dist.uninstall();
    } else if (sys.eq(cmd, "help")) {
        _ = io.print("{s}", .{USAGE}) catch {};
    } else {
        return usage(sys.f("x: unknown command '{s}'\n", .{cmd}));
    }
    _ = io.flush() catch {};
    return status;
}
