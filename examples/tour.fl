// A quick tour of Flint.

import std.fmt;
import std.heap;
import std.io;
import std.list;
import std.mem;

struct Vec2 {
    x: f64,
    y: f64,

    fn new(x: f64, y: f64) -> Vec2 { return Vec2 { x: x, y: y }; }
    fn len(self: Vec2) -> f64 { return sqrt(self.x * self.x + self.y * self.y); }
    fn scale(self: *Vec2, k: f64) {
        self.x *= k;
        self.y *= k;
    }
}

fn add(a: i64, b: i64) -> i64 { return a + b; }

fn sum(xs: []const i64) -> i64 {
    var total: i64 = 0;
    for (xs) |x| { total += x; }
    return total;
}

fn maxOf(comptime T: type, a: T, b: T) -> T { return if (a > b) a else b; }

fn main() -> !void {
    // Every allocation goes through an Allocator you pass around. This one finds leaks.
    var gpa = heap.DebugAllocator.init();
    defer gpa.deinit();
    let alloc = gpa.allocator();

    // `let` is immutable, `var` is mutable. Types come after the name.
    let count: i64 = 10;
    let pi = 3.14159;              // untyped number: a compile-time constant
    var small: u8 = 200;
    small +%= 100;                 // wrapping is spelled out: 300 wraps to 44
    try io.print("count {} pi {} small {}\n", .{ count, pi, small });

    // A growable array allocates through the allocator it's given
    var nums = list.ArrayList(i64).init(alloc);
    defer nums.deinit();
    try nums.appendSlice(&[_]i64 { 1, 2, 3 });
    try nums.append(4);
    try nums.append(add(2, 3));
    let xs = nums.items;
    try io.print("sum of {} items: {}\n", .{ xs.len, sum(xs) });
    for (xs) |x, i| {
        if (x % 2 == 0) { try io.print("  xs[{}] = {} is even\n", .{ i, x }); }
    }
    try io.print("sub-slice sum: {}, max: {}\n", .{ sum(xs[1..3]), maxOf(i64, xs[0], xs[4]) });

    // Structs and methods
    var v = Vec2.new(3, 4);
    try io.print("len: {}\n", .{v.len()});
    v.scale(2);                    // exactly Vec2.scale(&v, 2)
    try io.print("scaled: {} {}\n", .{ v.x, v.y });

    // Pointers and manual memory
    let p = try alloc.create(Vec2);
    defer alloc.destroy(p);
    p.* = Vec2.new(1.5, 0);
    p.scale(2);                    // methods and fields go through the pointer
    try io.print("heap vec: {} {}\n", .{ p.x, p.y });

    let buf = try alloc.alloc(u8, 16);
    defer alloc.free(buf);
    for (0..buf.len) |i| { buf[i] = 'a' + @truncate(u8, i); }
    let raw = buf.ptr; // [*]u8: a C-style pointer to many items
    unsafe { // a [*]T has no length, so indexing it isn't checked: that needs 'unsafe'
        try io.print("raw[3] = {c} via pointer math: {c}\n", .{ raw[3], (raw + 4)[0] });
    }

    // Strings are []const u8. Building one allocates, so it takes an allocator
    let s = "flint";
    try io.print("{s} has {} bytes; first is {c}; equal: {}\n", .{ s, s.len, s[0], mem.eql(u8, s, "flint") });
    let msg = try fmt.allocPrint(alloc, "{s}-{}", .{ s, 42 });
    defer alloc.free(msg);
    try io.print("built {s} ({} bytes) [{s:>8}] [{d:.2}]\n", .{ msg, msg.len, s, pi });

    // Explicit conversions between number types
    let ratio = count as f64 / 4;
    try io.print("ratio {} 0.1 + 0.2 = {}\n", .{ ratio, 0.1 + 0.2 });

    var n: i64 = 0;
    while (true) {
        n += 1;
        if (n >= 3) { break; }
    }
    try io.print("loop ran {} times {s}\n", .{ n, if (n == 3) "(ok)" else "(bad)" });
}
