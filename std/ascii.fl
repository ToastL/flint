// std.ascii - bytes as ASCII characters.

import std.mem;

pub fn isSpace(c: u8) -> bool { return c == ' ' || c == '\t' || c == '\n' || c == '\r'; }
pub fn isDigit(c: u8) -> bool { return c >= '0' && c <= '9'; }
pub fn isAlpha(c: u8) -> bool { return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z'); }
pub fn isUpper(c: u8) -> bool { return c >= 'A' && c <= 'Z'; }
pub fn isLower(c: u8) -> bool { return c >= 'a' && c <= 'z'; }

pub fn toUpper(c: u8) -> u8 { return if (isLower(c)) c - 32 else c; }
pub fn toLower(c: u8) -> u8 { return if (isUpper(c)) c + 32 else c; }

// An upper-case copy of s, in memory from `alloc`.
pub fn upperAlloc(alloc: mem.Allocator, s: []const u8) -> mem.AllocError![]u8 {
    let out = try alloc.alloc(u8, s.len);
    for (s) |c, i| { out[i] = toUpper(c); }
    return out;
}

// A lower-case copy of s, in memory from `alloc`.
pub fn lowerAlloc(alloc: mem.Allocator, s: []const u8) -> mem.AllocError![]u8 {
    let out = try alloc.alloc(u8, s.len);
    for (s) |c, i| { out[i] = toLower(c); }
    return out;
}
