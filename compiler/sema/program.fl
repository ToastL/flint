// sema.program - the whole program: declaring every module's types, functions and globals,
// lowering function bodies (parameters, the hidden result pointer), symbol names, and the
// `flint test` driver. lowerProgram is the entry point of sema.

import base.alloc;
import base.text;
import base.diag;
import syntax.token;
import syntax.ast;
import modules.unit;
import ir.ir;
import interp.run as interp;
import sema.state as st;
import sema.types as ty;
import sema.irbuild as b;
import sema.convert as cv;
import sema.names;
import sema.stmt;
import sema.errors;
import sema.enums;
import sema.globals;
import sema.ctexec;

fn getarg(cls: ir.Cls, idx: i64) -> i32 {
    let r = b.newVreg(cls);
    let i = b.emit(.GetArg);
    i.dst = r;
    i.cls = cls;
    i.imm = idx;
    return r;
}

// The return type turned out to be an aggregate: insert the hidden result pointer as x0.
pub fn addRetptr() {
    let cx = st.c();
    let e = &cx.f.blocks.items[0];
    for (e.insts.items) |*in| {
        if (in.op == .GetArg && in.cls == .I) {
            if (in.imm >= 1000) {
                diag.at(cx.fn_.?.decl.?.tok, text.f("'{s}' has many parameters, so give it a return type ('-> T') instead of inferring one", .{cx.fn_.?.name}));
            }
            in.imm += 1;
            if (in.imm >= 8) {
                diag.at(cx.fn_.?.decl.?.tok, text.f("'{s}' has many parameters, so give it a return type ('-> T') instead of inferring one", .{cx.fn_.?.name}));
            }
        }
    }
    var in = @zeroes(ir.Inst);
    in.op = .GetArg;
    in.cls = .I;
    in.slot = -1;
    in.dst = b.newVreg(.I);
    in.t1 = -1;
    in.t2 = -1;
    e.insts.push(in);
    let items = e.insts.items;
    var i = items.len - 1;
    while (i > 0) {
        items[i] = items[i - 1];
        i -= 1;
    }
    items[0] = in;
    cx.retptr = in.dst;
}

pub fn lowerFn(f: *st.FnInfo) {
    if (f.state != 0) { return; }
    f.state = 1;
    let ctx = alloc.new(st.Ctx);
    let saved = st.C;
    let saved_te = st.TE;
    let saved_unit = st.CU;
    let decl = f.decl.?;
    st.TE = f.tenv;
    st.CU = decl.unit;
    st.C = ctx;
    let irf = alloc.new(ir.IRFunc);
    irf.sym = f.sym;
    irf.name = if (f.recv) |rv| text.f("{s}.{s}", .{ty.tname(rv), f.name}) else f.name;
    irf.ct_only = ctexec.CT_DEPTH > 0;
    irf.is_main = f.recv == null && text.eq(f.name, "main") && f.unit != null && f.unit.?.is_root;
    irf.exported = decl.exported;
    ctx.f = irf;
    ctx.fn_ = f;
    ctx.retptr = -1;
    ctx.unsafe_depth = if (decl.is_unsafe) 1 else 0; // an unsafe fn's body is an unsafe context
    b.setBlk(b.newBlock());
    names.pushScope(false, -1, -1);
    var ic: i64 = 0;
    var fc: i64 = 0;
    var sk: i64 = 0; // arguments past the 8 registers of their class come on the stack
    if (f.ret != null && ty.isAgg(f.ret.?)) {
        ctx.retptr = getarg(.I, ic);
        ic += 1;
    }
    for (0..f.np()) |i| {
        let pt = f.pt.items[i];
        let ptok = f.ptok.items[i];
        ty.layout(pt, ptok);
        if (ty.isAgg(pt)) {
            var L: alloc.Vec(ty.Leaf) = .{};
            if (ty.leaves(pt, 0, &L, 4)) {
                let v = stmt.newLocal(f.pn.items[i], pt, ptok, false);
                let slot = v.slot;
                for (L.items) |l| {
                    let c = ty.clsOf(l.t);
                    let r = getarg(c, nextArg(c, &ic, &fc, &sk));
                    b.store(l.t, b.aSlot(slot, l.off as i64), b.R(r));
                }
            } else {
                let v = names.declare(f.pn.items[i], pt, ptok, false);
                v.kind = .Ref;
                v.param_copy = true;
                v.reg = getarg(.I, nextArg(.I, &ic, &fc, &sk));
            }
        } else {
            let c = ty.clsOf(pt);
            let r = getarg(c, nextArg(c, &ic, &fc, &sk));
            let v = stmt.newLocal(f.pn.items[i], pt, ptok, false);
            b.store(pt, b.aSlot(v.slot, 0), b.R(r));
        }
        if ((ic > 8 || fc > 8) && decl.exported) {
            diag.at(ptok, "too many parameters for a function C calls (up to 8 integer and 8 float registers are supported)");
        }
    }
    let body = decl.c.?;
    stmt.blockBody(body);
    if (f.ret == null) { f.ret = ty.void_; }
    let fr = f.ret.?;
    let ok_void = fr.k == .ErrUnion && fr.E() == ty.void_;
    if (fr != ty.void_ && !ok_void && !stmt.alwaysReturns(body)) {
        diag.at(decl.tok, text.f("function '{s}' doesn't return a value on every path", .{f.name}));
    }
    if (!b.terminated()) {
        if (fr == ty.void_) {
            _ = b.emit(.Ret);
        } else if (ok_void) {
            errors.retInst(b.IMM(0));
        } else {
            b.trap();
        }
    }
    irf.retcls = if (fr == ty.void_ || ty.isAgg(fr)) .None else ty.clsOf(fr);
    st.M.funcs.push(irf);
    st.C = saved;
    st.TE = saved_te;
    st.CU = saved_unit;
    f.state = 2;
}

// the next argument's place: a register index, or 1000 + its stack slot
fn nextArg(c: ir.Cls, ic: *i64, fc: *i64, sk: *i64) -> i64 {
    let cnt = if (c == .I) ic else fc;
    if (cnt.* < 8) {
        let r = cnt.*;
        cnt.* += 1;
        return r;
    }
    cnt.* += 1;
    let s = sk.*;
    sk.* += 1;
    return 1000 + s;
}

pub fn mangle(t: *ty.Type) -> []const u8 {
    if (t == ty.cstr_) { return "cstr"; }
    if (t.mname.len > 0) { return t.mname; }
    switch (t.k) {
        .Ptr => { return text.f("{s}{s}_{s}", .{if (t.many) "m" else "p", if (t.is_const) "c" else "", mangle(t.E())}); }
        .Slice => { return text.f("s{s}_{s}", .{if (t.is_const) "c" else "", mangle(t.E())}); }
        .Opt => { return text.f("o_{s}", .{mangle(t.E())}); }
        .Array => { return text.f("a{}_{s}", .{t.alen, mangle(t.E())}); }
        .Vector => { return text.f("v{}_{s}", .{t.alen, mangle(t.E())}); }
        .ErrUnion => { return text.f("e_{s}", .{mangle(t.E())}); }
        else => { return ty.tname(t); }
    }
}

fn isGenericParam(p: *ast.Node) -> bool {
    return p.flag != 0 || (p.a.?.k == .TName && text.eq(p.a.?.name, "anytype"));
}

pub fn declareFn(d: *ast.Node, ext: bool) {
    let su = st.CU;
    if (d.unit) |u| { st.CU = u; }
    declareFnIn(d, ext);
    st.CU = su;
}

fn declareFnIn(d: *ast.Node, ext: bool) {
    let f = alloc.new(st.FnInfo);
    f.name = d.name;
    f.decl = d;
    f.ext = ext;
    f.variadic = d.flag == 1;
    f.unit = d.unit;
    f.is_pub = d.is_pub;
    f.lib = d.unit != null && d.unit.?.is_std; // the standard library: lowered only if used
    if (d.a) |ra| {
        let rv = names.resolve(ra);
        f.recv = rv;
        let rn = ty.tname(rv);
        if (rv == ty.void_) { diag.at(d.tok, "can't add methods to void"); }
        if (names.findMethod(rv, d.name) != null) { diag.at(d.tok, text.f("method '{s}.{s}' is already defined", .{rn, d.name})); }
        for (rv.fields.items) |*fd| {
            if (text.eq(fd.name, d.name)) { diag.at(d.tok, text.f("'{s}' already has a field named '{s}'", .{rn, d.name})); }
        }
        let builtin_field = text.eq(d.name, "len") || text.eq(d.name, "ptr");
        if (ty.isSlice(rv) && builtin_field) { diag.at(d.tok, text.f("'{s}' is a built-in field of {s}", .{d.name, rn})); }
        f.sym = text.f("_fl_{s}_{s}", .{mangle(rv), d.name});
    } else {
        let prev = names.fnIn(st.CU, d.name);
        if (ext && prev != null && prev.?.ext) { return; } // repeated extern
        if (prev != null) { diag.at(d.tok, text.f("function '{s}' is already defined", .{d.name})); }
        if (names.isBuiltin(d.name)) { diag.at(d.tok, text.f("'{s}' is a builtin and can't be redefined", .{d.name})); }
        if (names.aliasUnit(d.name) != null || names.aliasHeader(d.name) != null) {
            diag.at(d.tok, text.f("'{s}' is already the name of an import", .{d.name}));
        }
        f.sym = if (ext || d.exported) text.f("_{s}", .{d.name}) else text.f("_fl_{s}{s}", .{if (st.CU) |u| u.prefix else "", d.name});
    }
    f.tenv = st.TE;
    f.type_fn = d.b != null && d.b.?.k == .TName && text.eq(d.b.?.name, "type");
    f.generic = f.type_fn;
    for (d.list.items) |p| { if (isGenericParam(p)) { f.generic = true; } }
    if (f.generic && ext) { diag.at(d.tok, "an extern function can't have comptime or anytype parameters"); }
    if (f.generic && d.exported) { diag.at(d.tok, "an exported function can't have comptime or anytype parameters"); }
    for (0..d.count()) |i| {
        let p = d.at(i);
        f.pn.push(p.name);
        f.ptok.push(p.tok);
        // a generic function's parameter types may name its comptime parameters: they're resolved
        // per call (void_ stands in for "not known yet")
        if (!f.generic || (i == 0 && f.recv != null && !isGenericParam(p))) { f.pt.push(names.resolve(p.a.?)); } else { f.pt.push(ty.void_); }
        for (0..i) |j| {
            if (text.eq(f.pn.items[j], p.name)) { diag.at(p.tok, text.f("duplicate parameter '{s}'", .{p.name})); }
        }
    }
    if (f.recv) |rv| {
        if (f.np() > 0) { // a first parameter of type T or *T makes it callable as x.f()
            let p0 = f.pt.items[0];
            if (p0 == rv) {
                f.self_kind = 1;
            } else if (ty.isPtr(p0) && p0.elem == rv) {
                f.self_kind = 2;
            }
        }
    }
    if (f.generic) {
        f.ret = null; // resolved per instance
    } else if (d.b) |rb| {
        f.ret = names.resolve(rb);
    } else {
        f.ret = ty.void_; // no '-> T' means void
    }
    if (ext && f.ret != null && ty.isAgg(f.ret.?)) {
        diag.at(d.b.?.tok, text.f("an extern function can't return {s} yet (C returns small structs in registers, which Flint's calls to C don't handle): have the C side write it through a pointer parameter", .{ty.tname(f.ret.?)}));
    }
    if (ext) { f.state = 2; }
    st.fns.push(f);
}

// a struct's fields, from its declaration (methods are declared separately)
pub fn structFields(t: *ty.Type, s: *ast.Node) {
    t.fields = .{};
    for (s.list.items) |f| {
        if (f.k != .Field) { continue; } // methods are declared below
        for (t.fields.items) |*o| { if (text.eq(o.name, f.name)) { diag.at(f.tok, text.f("duplicate field '{s}'", .{f.name})); } }
        var fd = @zeroes(ty.Field);
        fd.name = f.name;
        let ft = f.a.?;
        let (bw, sg) = if (ft.k == .TName) ty.bitwidthName(ft.name) else .{0, false};
        if (bw != 0 && t.is_packed) { // u3: held in the next full-width integer, stored in 3 bits
            fd.t = if (bw <= 8) (if (sg) ty.i8_ else ty.u8_) else if (bw <= 16) (if (sg) ty.i16_ else ty.u16_)
                   else if (bw <= 32) (if (sg) ty.i32_ else ty.u32_) else (if (sg) ty.i64_ else ty.u64_);
            fd.bits = bw;
            fd.sbits = sg;
        } else {
            fd.t = names.resolve(ft);
        }
        if (t.is_union && f.b != null) { diag.at(f.b.?.tok, "union fields can't have defaults (a literal sets exactly one)"); }
        fd.tok = f.tok;
        fd.def = f.b;
        t.fields.push(fd);
    }
}

// types declared inside types (Outer.Inner) become top-level items, right after their parent
fn flatten(it: *ast.Node, out: *alloc.Vec(*ast.Node)) {
    out.push(it);
    if (it.k != .Struct) { return; }
    for (it.list.items) |m| { if (m.k == .Struct || m.k == .Enum) { flatten(m, out); } }
}

fn isTypeFn(d: *ast.Node) -> bool { return d.k == .Fn && d.b != null && d.b.?.k == .TName && text.eq(d.b.?.name, "type"); }

pub fn lowerProgram(units: []*unit.Unit, mode: ir.Mode, test_mode: bool) -> *ir.Module {
    ty.init();
    st.M = alloc.new(ir.Module);
    interp.init(st.M, ctexec.ctLookup);
    st.MODE = mode;
    st.UNITS = units;
    var all: alloc.Vec(*ast.Node) = .{};
    for (units) |u| { for (u.items) |it| { flatten(it, &all); } }
    let items = all.items;
    for (items) |s| {
        if (s.k != .Struct && s.k != .Enum && s.k != .ErrSet) { continue; }
        st.CU = s.unit;
        let cu = st.cu();
        if (names.typeIn(cu, s.name) != null || text.eq(s.name, "anyerror")) { diag.at(s.tok, text.f("type '{s}' is already defined", .{s.name})); }
        if (names.aliasUnit(s.name) != null || names.aliasHeader(s.name) != null) {
            diag.at(s.tok, text.f("'{s}' is already the name of an import", .{s.name}));
        }
        let t = alloc.new(ty.Type);
        t.k = if (s.k == .Enum) .Enum else if (s.k == .ErrSet) .ErrSet else .Struct;
        t.name = s.name;
        t.unit = cu;
        t.is_pub = s.is_pub;
        if (cu.dname.len > 0) { t.dname = text.f("{s}{s}", .{cu.dname, s.name}); }
        if (text.indexOf(s.name, '.') != null || cu.prefix.len > 0) { // Outer.Inner, or a module's type: no '.' in symbols
            let m = alloc.dupe(u8, text.f("{s}{s}", .{cu.prefix, s.name}));
            for (0..m.len) |i| { if (m[i] == '.') { m[i] = '_'; } }
            t.mname = m;
        }
        if (s.k == .ErrSet) { // error FileError { NotFound, ... }
            t.size = 2;
            t.align = 2;
            t.state = 2;
            for (s.list.items) |en| {
                let code = cv.errCode(en.name);
                for (t.errcodes.items) |c| { if (c == code) { diag.at(en.tok, text.f("duplicate error '{s}'", .{en.name})); } }
                t.errcodes.push(code);
            }
        }
        if (s.k == .Struct) {
            t.is_packed = s.flag == 1;
            t.is_union = s.flag == 2;
        }
        st.structs.push(t);
    }
    for (items) |it| {
        if (it.k == .Enum) {
            st.CU = it.unit;
            enums.declareEnum(it);
        }
    }
    for (items) |it| { // constants first: types like [N]u8 may use them
        if (it.k == .Let && it.flag != 0 && it.a == null && it.b != null && globals.simpleConst(it.b)) {
            st.CU = it.unit;
            if (names.aliasUnit(it.name) != null || names.aliasHeader(it.name) != null) {
                diag.at(it.tok, text.f("'{s}' is already the name of an import", .{it.name}));
            }
            globals.globalLetIn(it, null);
            it.flag2 = 1;
        }
    }
    for (items) |it| { // functions that make types first: fields and signatures may use them
        if (isTypeFn(it)) {
            st.CU = it.unit;
            declareFn(it, false);
        }
    }
    for (items) |it| {
        if (it.k == .Struct) {
            st.CU = it.unit;
            structFields(names.typeIn(st.CU, it.name).?, it);
        }
    }
    var si: usize = 0;
    while (si < st.structs.items.len) { // (laying out may make more: generic instances)
        let t = st.structs.items[si];
        st.CU = t.unit;
        ty.layout(t, null);
        si += 1;
    }
    for (items) |it| {
        st.CU = it.unit;
        if (it.k == .Fn) {
            if (!isTypeFn(it)) { declareFn(it, false); }
        } else if (it.k == .Struct || it.k == .Enum) {
            for (it.list.items) |m| { if (m.k == .Fn) { declareFn(m, false); } }
        } else if (it.k == .Extern) {
            for (it.list.items) |m| { declareFn(m, true); }
        }
    }
    for (items) |it| { // globals are made when first used, so their order doesn't matter
        st.CU = it.unit;
        if (it.k == .Let && it.flag2 == 0) {
            if (it.is_extern) { globals.globalLetIn(it, null); } else { globals.declareLazy(it, null); }
        }
        if (it.k == .Struct) {
            for (it.list.items) |m| {
                if (m.k == .Let) { globals.declareLazy(m, names.typeIn(st.CU, it.name)); }
            }
        }
    }
    let root = units[0];
    st.CU = root;
    let mainf = names.fnIn(root, "main");
    if (!test_mode) {
        if (mainf == null || mainf.?.ext) { diag.at(null, "no 'fn main()' found"); }
        if (mainf.?.np() > 0) { diag.at(mainf.?.decl.?.tok, "main takes no parameters (use args() to read command-line arguments)"); }
    }
    // the standard library, generic instances and their methods: only when used
    var i: usize = 0;
    while (i < st.fns.items.len) {
        let f = st.fns.items[i];
        if (!f.ext && (!f.lib || f.decl.?.exported) && !f.generic && !f.lazy && !(test_mode && f == mainf)) { lowerFn(f); }
        i += 1;
    }
    i = 0;
    while (i < st.gvars.items.len) { // the program's own globals, even unused ones
        let g = st.gvars.items[i];
        if (g.kind == .Lazy && g.name.len > 0 && g.unit != null && !g.unit.?.is_std) { _ = globals.materialize(i); }
        i += 1;
    }
    for (items) |it| { // top-level comptime { ... } blocks
        if (it.k == .Comptime) {
            st.CU = it.unit;
            st.TE = null;
            ctexec.ctBlock(it.a.?);
        }
    }
    if (test_mode) {
        lowerTests(units);
    } else {
        let mf = mainf.?;
        let mr = mf.ret.?;
        st.M.main_errors = mr.k == .ErrUnion && mr.E() == ty.void_;
        if (mr != ty.void_ && !ty.isInt(mr) && !st.M.main_errors) {
            diag.at(mf.decl.?.tok, "main must return nothing, an integer exit code, or !void");
        }
    }
    _ = cv.errCode("(no error)"); // make sure the error-name table exists
    ctexec.pruneCtOnly();
    return st.M;
}

// flint test: each `test "name" { ... }` becomes a function returning !void (its error code comes
// back in x0), and main hands them to the runtime one at a time: it runs each in its own process,
// so a panic fails only that test.
fn lowerTests(units: []*unit.Unit) {
    var tests: alloc.Vec(*st.FnInfo) = .{};
    var names_: alloc.Vec([]const u8) = .{};
    for (units) |u| {
        if (u.is_std) { continue; }
        for (u.items) |t| {
            if (t.k != .Test) { continue; }
            let d = alloc.new(ast.Node);
            d.* = t.*;
            d.k = .Fn;
            d.name = "test";
            let f = alloc.new(st.FnInfo);
            f.name = text.f("test \"{s}\"", .{t.str});
            f.decl = d;
            f.unit = u;
            f.ret = ty.errUnion(ty.anyerror, ty.void_);
            f.sym = text.f("_fl_test_{}", .{tests.items.len});
            st.CU = u;
            lowerFn(f);
            tests.push(f);
            names_.push(if (u.is_root) t.str else text.f("{s}: {s}", .{u.path, t.str}));
        }
    }
    let mainf = alloc.new(st.FnInfo);
    mainf.name = "main";
    mainf.ret = ty.i64_;
    let ctx = alloc.new(st.Ctx);
    st.C = ctx;
    let irf = alloc.new(ir.IRFunc);
    irf.sym = "_fl_main";
    irf.is_main = true;
    ctx.f = irf;
    ctx.fn_ = mainf;
    ctx.retptr = -1;
    b.setBlk(b.newBlock());
    names.pushScope(false, -1, -1);
    for (0..tests.items.len) |i| {
        let nv = b.strLit(names_.items[i]);
        let p = b.load(ty.ptrTo(ty.u8_), nv.a);
        _ = b.callI("_rt_test_run", .None, &[_]ir.Opd { b.R(p), b.IMM(names_.items[i].len as i64), b.R(b.addrSym(tests.items[i].sym)) });
    }
    let r = b.callI("_rt_test_end", .I, &[_]ir.Opd {});
    let ret = b.emit(.Ret);
    ret.a = b.R(r);
    ret.cls = .I;
    irf.retcls = .I;
    st.M.funcs.push(irf);
    st.C = null;
}
