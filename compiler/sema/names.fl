// sema.names - finding what a name means: comptime bindings, local variables, the current module's
// declarations, imported modules (alias.Name) and C headers; resolving type nodes to Types; and
// `pub` checks. Every top-level name belongs to the file (Unit) that declares it.

import base.alloc;
import base.text;
import base.diag;
import syntax.token;
import syntax.ast;
import modules.unit;
import modules.load;
import cimport.ctypes;
import sema.state as st;
import sema.types as ty;
import sema.globals;
import sema.generics;
import sema.cdecls;

pub fn envFind(name: []const u8) -> ?*st.Binding {
    var e = st.TE;
    while (e) |env| {
        var i = env.b.items.len;
        while (i > 0) {
            i -= 1;
            if (text.eq(env.b.items[i].name, name)) { return env.b.items[i]; }
        }
        e = env.parent;
    }
    return null;
}

// the module an import alias names in the current file (`io` for `import std.io;`)
pub fn aliasUnit(name: []const u8) -> ?*unit.Unit {
    let u = st.CU orelse return null;
    for (u.imports.items) |*im| { if (text.eq(im.alias, name)) { return im.u; } }
    return null;
}

pub fn aliasHeader(name: []const u8) -> ?*ctypes.CHeader {
    let u = st.CU orelse return null;
    for (u.imports.items) |*im| { if (text.eq(im.alias, name)) { return im.c; } }
    return null;
}

pub fn typeIn(u: ?*unit.Unit, name: []const u8) -> ?*ty.Type {
    for (st.structs.items) |t| { if (t.unit == u && text.eq(t.name, name)) { return t; } }
    return null;
}

// a type by name: a comptime binding, a type of this module, or alias.Name from an imported one
pub fn findStruct(name: []const u8) -> ?*ty.Type {
    if (envFind(name)) |b| { if (b.type_) |bt| { return bt; } }
    if (localType(name)) |t| { return t; }
    if (typeIn(st.CU, name)) |t| { return t; }
    if (globalType(st.CU, name)) |t| { return t; }
    if (text.indexOf(name, '.')) |dot| {
        let first = name[0..dot];
        if (aliasUnit(first)) |u| {
            if (typeIn(u, name[dot + 1..])) |ut| { return ut; }
            return globalType(u, name[dot + 1..]);
        }
        if (aliasHeader(first)) |h| { return cdecls.cTypeNamed(h, name[dot + 1..], null); }
    }
    return null;
}

pub fn unitName(u: *unit.Unit) -> []const u8 { return if (u.is_root) "the main module" else u.path; }

// using another module's declaration needs 'pub'
pub fn checkPub(owner: ?*unit.Unit, is_pub: bool, what: []const u8, tok: ?*token.Token) {
    let o = owner orelse return;
    if (is_pub || o == st.CU) { return; }
    diag.at(tok, text.f("'{s}' is private to {s}; mark it 'pub' to use it from another module", .{what, unitName(o)}));
}

pub fn checkTypePub(t: ?*ty.Type, tok: ?*token.Token) {
    let tt = t orelse return;
    if (tok) |tk| {
        if (tk.k == .Id) { // a comptime binding was named by the caller
            if (envFind(tk.s)) |b| { if (b.type_ == tt) { return; } }
        }
    }
    if ((tt.k == .Struct || tt.k == .Enum || tt.k == .ErrSet) && tt.unit != null) { checkPub(tt.unit, tt.is_pub, tt.name, tok); }
}

// a type node names things in the module it was written in
pub fn resolve(n: *ast.Node) -> *ty.Type {
    let su = st.CU;
    if (n.unit) |u| { st.CU = u; }
    let t = resolveIn(n);
    st.CU = su;
    return t;
}

fn resolveIn(n: *ast.Node) -> *ty.Type {
    if (n.k == .TypeExpr) { return resolve(n.a.?); }
    if (n.k == .TTypeOf) { return generics.typeOfExpr(n.a.?); }
    if (n.k == .TGeneric) { return generics.genericType(n); }
    if (n.k == .TVector) { // @Vector(4, f32): one SIMD register
        let len = globals.evalConstInt(n.c.?, "a vector length");
        let e = resolve(n.a.?);
        let ok = (ty.isInt(e) && !ty.isLit(e)) || e.k == .F32 || e.k == .F64;
        if (!ok) { diag.at(n.a.?.tok, text.f("a vector's elements must be integers or floats, not {s}", .{ty.tname(e)})); }
        let bytes = len *% e.size as i64;
        if (len < 2 || (bytes != 8 && bytes != 16)) {
            diag.at(n.tok, text.f("@Vector({}, {s}) would be {} bytes; a vector is one SIMD register: 8 or 16 bytes with at least 2 elements (split it, or use an array)", .{len, ty.tname(e), bytes}));
        }
        return ty.vectorOf(e, len);
    }
    if (n.k != .TName && n.k != .TPtr && n.k != .TErrU && n.k != .TArray && n.k != .TTuple && n.k != .TFn &&
        n.k != .TOpt && n.k != .TSlice) {
        diag.at(n.tok, "expected a type here");
    }
    if (n.k == .TPtr) {
        let e = resolve(n.a.?);
        if (n.flag2 != 0) {
            if (e == ty.void_) { diag.at(n.tok, "[*]void has no item size; use *void"); }
            return ty.manyPtrQ(e, n.flag != 0);
        }
        return ty.ptrToQ(e, n.flag != 0);
    }
    if (n.k == .TErrU) {
        let set = if (n.a) |a| resolve(a) else ty.anyerror;
        if (set.k != .ErrSet) { diag.at(n.a.?.tok, text.f("'{s}' isn't an error set, so it can't go before '!'", .{ty.tname(set)})); }
        let e = resolve(n.b.?);
        if (e.k == .ErrUnion) { diag.at(n.tok, "nested error unions aren't supported"); }
        return ty.errUnion(set, e);
    }
    if (n.k == .TArray) {
        let lc = n.c orelse diag.at(n.tok, "'[_]' infers the length from an array literal, so it can't be used here; write the length");
        let len = globals.evalConstInt(lc, "an array length");
        if (len < 0) { diag.at(lc.tok, text.f("an array length can't be negative ({})", .{len})); }
        let e = resolve(n.a.?);
        if (e == ty.void_ || e == ty.noreturn_) { diag.at(n.a.?.tok, text.f("can't have an array of {s}", .{ty.tname(e)})); }
        return ty.arrayOf(e, len);
    }
    if (n.k == .TTuple) {
        var ts: alloc.Vec(*ty.Type) = .{};
        for (n.list.items) |el| {
            let t = resolve(el);
            if (t == ty.void_ || t == ty.noreturn_) { diag.at(el.tok, text.f("a tuple can't hold {s}", .{ty.tname(t)})); }
            ts.push(t);
        }
        return ty.tupleOf(ts.items);
    }
    if (n.k == .TFn) {
        var pt: alloc.Vec(*ty.Type) = .{};
        for (n.list.items) |el| {
            let t = resolve(el);
            if (t == ty.void_) { diag.at(el.tok, "a parameter can't be void"); }
            pt.push(t);
        }
        return ty.fnType(pt.items, if (n.b) |b| resolve(b) else ty.void_, n.flag == 1);
    }
    if (n.k == .TOpt) {
        let e = resolve(n.a.?);
        if (e.k == .Opt) { diag.at(n.tok, "nested optionals (??T) aren't supported"); }
        if (e == ty.void_) { diag.at(n.tok, "?void isn't a useful type; use bool"); }
        return ty.optOf(e);
    }
    if (n.k == .TSlice) {
        let e = resolve(n.a.?);
        if (e == ty.void_) { diag.at(n.tok, "can't have a slice of void"); }
        return ty.sliceOfQ(e, n.flag != 0);
    }
    if (ty.primType(n.name)) |pt| { return pt; }
    let cdot = text.indexOf(n.name, '.');
    if (cdot) |d| { // c.FILE: with a location for errors
        if (aliasHeader(n.name[0..d])) |h| { return cdecls.cTypeNamed(h, n.name[d + 1..], n.tok).?; }
    }
    if (findStruct(n.name)) |s| {
        checkTypePub(s, n.tok);
        return s;
    }
    if (cdot) |d| {
        let first = n.name[0..d];
        if (aliasUnit(first)) |u| { diag.at(n.tok, text.f("{s} has no type '{s}'", .{u.path, n.name[d + 1..]})); }
        if (aliasHeader(first) == null && load.stdHas(first)) {
            diag.at(n.tok, text.f("unknown type '{s}' ('{s}' is a module of the standard library: add 'import std.{s};')", .{n.name, first, first}));
        }
    }
    if (text.eq(n.name, "type") || text.eq(n.name, "anytype")) {
        diag.at(n.tok, text.f("'{s}' can only be the type of a function parameter (comptime T: type, x: anytype)", .{n.name}));
    }
    if (envFind(n.name)) |vb| {
        if (vb.type_ == null) { diag.at(n.tok, text.f("'{s}' is a compile-time value, not a type", .{n.name})); }
    }
    let (bw, _) = ty.bitwidthName(n.name);
    if (bw != 0) {
        diag.at(n.tok, text.f("'{s}' can only be the type of a packed struct field (bit fields); use a full-width integer here", .{n.name}));
    }
    if (text.eq(n.name, "int") || text.eq(n.name, "float") || text.eq(n.name, "byte")) {
        diag.at(n.tok, text.f("unknown type '{s}': Flint only has fixed-width types (i32, i64, u8, f64, ...)", .{n.name}));
    }
    diag.at(n.tok, text.f("unknown type '{s}'", .{n.name}));
}

let BUILTINS = [_][]const u8 {
    "exit", "assert", "panic", "now", "args",
    "min", "max", "abs", "sqrt", "sin", "cos", "tan", "exp",
    "log", "floor", "ceil", "round", "pow", "atan2",
};

pub fn isBuiltin(s: []const u8) -> bool { return text.oneOf(s, BUILTINS[..]); }

pub fn fnIn(u: ?*unit.Unit, name: []const u8) -> ?*st.FnInfo {
    for (st.fns.items) |f| { if (f.recv == null && f.unit == u && text.eq(f.name, name)) { return f; } }
    return null;
}

pub fn findFn(name: []const u8) -> ?*st.FnInfo { return fnIn(st.CU, name); }

pub fn findMethod(recv: *ty.Type, name: []const u8) -> ?*st.FnInfo {
    for (st.fns.items) |f| { if (f.recv == recv && text.eq(f.name, name)) { return f; } }
    return null;
}

pub fn globalIn(u: ?*unit.Unit, name: []const u8) -> ?*st.Var {
    for (0..st.gvars.items.len) |i| {
        let g = st.gvars.items[i];
        if (g.unit == u && text.eq(g.name, name)) { return if (g.kind == .Lazy) globals.materialize(i) else g; }
    }
    return null;
}

// the last variable named `name` in a scope chain
fn inScopes(sc: ?*st.Scope, name: []const u8) -> ?*st.Var {
    var s = sc;
    while (s) |scope| {
        var i = scope.vars.items.len;
        while (i > 0) {
            i -= 1;
            if (text.eq(scope.vars.items[i].name, name)) { return scope.vars.items[i]; }
        }
        s = scope.parent;
    }
    return null;
}

pub fn findVar(name: []const u8) -> ?*st.Var {
    if (st.C) |cx| {
        if (!st.G_ONLY) {
            if (inScopes(cx.cur, name)) |v| { return v; }
            // comptime code sees the constants of the function around it, not its variables
            var o = if (cx.ct_scratch) cx.outer else null;
            while (o) |oc| {
                if (inScopes(oc.cur, name)) |v| {
                    if (v.kind == .Const || v.kind == .CStr || v.kind == .Type) { return v; }
                    diag.at(st.CUR_TOK, text.f("'{s}' is a runtime variable, so comptime code can't use it", .{name}));
                }
                o = if (oc.ct_scratch) oc.outer else null;
            }
        }
    }
    if (!st.G_ONLY) {
        if (envFind(name)) |b| { if (b.type_ == null) { return b.var_; } }
    }
    return globalIn(st.CU, name);
}

// let T = List(i32); inside a function (or a comptime value around comptime code)
pub fn localType(name: []const u8) -> ?*ty.Type {
    var o = st.C;
    while (o) |oc| {
        if (st.G_ONLY) { break; }
        if (inScopes(oc.cur, name)) |v| { return if (v.kind == .Type) v.t else null; }
        o = if (oc.ct_scratch) oc.outer else null;
    }
    return null;
}

// let IntList = List(i32); at the top level of module u (set up on first use)
pub fn globalType(u: ?*unit.Unit, name: []const u8) -> ?*ty.Type {
    if (u != st.CU) { // another module's: only if it's pub
        for (st.gvars.items) |g| { if (g.unit == u && text.eq(g.name, name) && !g.is_pub) { return null; } }
    }
    for (0..st.gvars.items.len) |i| {
        let g = st.gvars.items[i];
        if (g.unit != u || !text.eq(g.name, name)) { continue; }
        if (g.kind == .Lazy && !g.busy) {
            let v = globals.materialize(i) orelse return null;
            return if (v.kind == .Type) v.t else null;
        }
        if (g.kind == .Type) { return g.t; }
    }
    return null;
}

// is this name a local variable (or a comptime value) right here? Those hide imports.
pub fn isLocal(name: []const u8) -> bool {
    var o = st.C;
    while (o) |oc| {
        if (inScopes(oc.cur, name) != null) { return true; }
        o = if (oc.ct_scratch) oc.outer else null;
    }
    return envFind(name) != null;
}

// `io` in `io.print`: the module an import alias names (unless a local hides it)
pub fn unitRef(n: *ast.Node) -> ?*unit.Unit {
    if (n.k != .Name || isLocal(n.name)) { return null; }
    let su = st.CU;
    if (n.unit) |u| { st.CU = u; }
    let r = aliasUnit(n.name);
    st.CU = su;
    return r;
}

pub fn headerRef(n: *ast.Node) -> ?*ctypes.CHeader {
    if (n.k != .Name || isLocal(n.name)) { return null; }
    let su = st.CU;
    if (n.unit) |u| { st.CU = u; }
    let h = aliasHeader(n.name);
    st.CU = su;
    return h;
}

pub fn lookup(name: []const u8, tok: ?*token.Token) -> *st.Var {
    if (findVar(name)) |v| { return v; }
    if (findFn(name) != null || isBuiltin(name)) { diag.at(tok, text.f("'{s}' is a function; call it with ()", .{name})); }
    if (findStruct(name) != null) { diag.at(tok, text.f("'{s}' is a type, not a value", .{name})); }
    if (aliasUnit(name) != null || aliasHeader(name) != null) {
        diag.at(tok, text.f("'{s}' is a module; use one of its members: {s}.name", .{name, name}));
    }
    if (load.stdHas(name)) { diag.at(tok, text.f("'{s}' is not defined (it's a module of the standard library: add 'import std.{s};')", .{name, name})); }
    diag.at(tok, text.f("'{s}' is not defined", .{name}));
}

// ---- scopes ----

pub fn pushScope(loop: bool, brk: i32, cont: i32) {
    let cx = st.c();
    let s = alloc.new(st.Scope);
    s.parent = cx.cur;
    s.loop = loop;
    s.brk = brk;
    s.cont = cont;
    s.unsafe_depth = cx.unsafe_depth;
    cx.cur = s;
}

pub fn popScope() { st.c().cur = st.c().cur.?.parent; }

pub fn declare(name: []const u8, t: *ty.Type, tok: ?*token.Token, is_const: bool) -> *st.Var {
    let s = st.c().cur.?;
    for (s.vars.items) |v| { if (text.eq(v.name, name)) { diag.at(tok, text.f("'{s}' is already declared in this scope", .{name})); } }
    if (t == ty.void_ || t == ty.null_ || ty.isLit(t)) { diag.at(tok, text.f("can't declare '{s}' with type {s}", .{name, ty.tname(t)})); }
    if (t == ty.type_) { diag.at(tok, text.f("'{s}' would hold a type, which only exists at compile time: use 'let {s} = ...;'", .{name, name})); }
    let v = alloc.new(st.Var);
    v.name = name;
    v.t = t;
    v.is_const = is_const;
    v.slot = -1;
    v.reg = -1;
    s.vars.push(v);
    return v;
}

pub fn requireUnsafe(t: ?*token.Token, what: []const u8) {
    if (!st.inUnsafe()) { diag.at(t, text.f("{s} is only allowed inside an 'unsafe' block", .{what})); }
}
