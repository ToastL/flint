// sema.stmt - statements: let/var (and constants, type aliases, destructuring), assignments, if,
// while, for loops, return (with defers and errdefers), break/continue, defer, blocks; and the
// checks for "this function always returns".

import base.alloc;
import base.text;
import base.diag;
import syntax.token;
import syntax.ast;
import ir.ir;
import sema.state as st;
import sema.types as ty;
import sema.irbuild as b;
import sema.convert as cv;
import sema.names;
import sema.access;
import sema.expr;
import sema.ops;
import sema.optional;
import sema.errors;
import sema.cases;
import sema.ctexec;
import sema.ctbranch;
import sema.members;
import sema.program;
import sema.asmblock;

// Runs the defers of every scope from the innermost up to `stop` (null: all). errdefers run only
// when `err` is given, i.e. when leaving with an error.
pub fn emitDefersErr(stop: ?*st.Scope, err: ?*b.Val) {
    let cx = st.c();
    var sc = cx.cur;
    while (sc) |s| {
        var i = s.defers.items.len;
        while (i > 0) {
            i -= 1;
            let dn = s.defers.items[i];
            if (dn.flag != 0 && err == null) { continue; }
            let saved = cx.cur;
            let saved_unsafe = cx.unsafe_depth;
            cx.cur = s;
            cx.unsafe_depth = s.unsafe_depth;
            names.pushScope(false, -1, -1);
            if (dn.flag != 0 && dn.name.len > 0 && !text.eq(dn.name, "_")) {
                let e = err.?;
                let ev = newLocal(dn.name, e.t, dn.tok, true);
                b.store(e.t, b.aSlot(ev.slot, 0), b.opdOf(e.*));
            }
            let d = dn.a.?;
            cx.defer_depth += 1;
            if (d.k == .Block) {
                for (d.list.items) |x| { stmt(x); }
            } else {
                stmt(d);
            }
            cx.defer_depth -= 1;
            cx.cur = saved;
            cx.unsafe_depth = saved_unsafe;
        }
        if (s == stop) { break; }
        sc = s.parent;
    }
}

pub fn emitDefers(stop: ?*st.Scope) { emitDefersErr(stop, null); }

fn endsInJump(blk: *ast.Node) -> bool {
    if (blk.count() == 0) { return false; }
    let k = blk.at(blk.count() - 1).k;
    return k == .Return || k == .Break || k == .Continue;
}

pub fn blockBody(blk: *ast.Node) {
    for (blk.list.items) |s| { stmt(s); }
    if (!endsInJump(blk)) { emitDefers(st.c().cur); }
}

fn subBlock(blk: *ast.Node, loop: bool, brk: i32, cont: i32) {
    names.pushScope(loop, brk, cont);
    blockBody(blk);
    names.popScope();
}

fn checkFree(name: []const u8, tok: ?*token.Token) {
    for (st.c().cur.?.vars.items) |v| {
        if (text.eq(v.name, name)) { diag.at(tok, text.f("'{s}' is already declared in this scope", .{name})); }
    }
}

// let n = 42;  ->  a compile-time constant, inlined at every use
fn declareConst(name: []const u8, v: b.Val, tok: ?*token.Token) {
    checkFree(name, tok);
    let var_ = compileTimeVar();
    var_.name = name;
    var_.t = v.t;
    var_.kind = .Const;
    var_.is_const = true;
    var_.cival = v.ival;
    var_.cfval = v.fval;
    st.c().cur.?.vars.push(var_);
}

fn declareTypeAlias(name: []const u8, t: *ty.Type, tok: ?*token.Token) {
    checkFree(name, tok);
    let var_ = compileTimeVar();
    var_.name = name;
    var_.t = t;
    var_.kind = .Type;
    var_.is_const = true;
    st.c().cur.?.vars.push(var_);
}

// a Var that isn't a variable at run time (a constant or a type alias): no slot, no register
fn compileTimeVar() -> *st.Var {
    let v = alloc.new(st.Var);
    v.slot = -1;
    v.reg = -1;
    return v;
}

// does e use only names known at compile time (no runtime variables)?
fn refsOnlyComptime(m: ?*ast.Node) -> bool {
    let e = m orelse return true;
    if (e.k == .Name) {
        let v = names.findVar(e.name) orelse return true;
        return v.kind == .Const || v.kind == .CStr || v.kind == .Type || v.kind == .Global || v.kind == .Lazy;
    }
    if (e.k == .Struct) { return false; } // a type made here is made by this function's own lowering
    if (!refsOnlyComptime(e.a) || !refsOnlyComptime(e.b) || !refsOnlyComptime(e.c)) { return false; }
    for (e.list.items) |c| { if (!refsOnlyComptime(c)) { return false; } }
    return true;
}

pub fn newLocal(name: []const u8, t: *ty.Type, tok: ?*token.Token, is_const: bool) -> *st.Var {
    let v = names.declare(name, t, tok, is_const);
    v.kind = .Slot;
    v.slot = b.newSlot(t);
    return v;
}

// the local variable (or by-value parameter) whose memory `x` is part of, or null: x, x.f, x[i]
// where every step stays inside the variable (no pointer or slice in between)
fn localRoot(x: *ast.Node, t: *?*ty.Type) -> ?*st.Var {
    if (x.k == .Name) {
        let v = names.findVar(x.name) orelse return null;
        if (!(v.kind == .Slot || (v.kind == .Ref && v.param_copy))) { return null; }
        t.* = v.t;
        return v;
    }
    var bt: ?*ty.Type = null;
    if (x.k == .FieldAcc) {
        let v = localRoot(x.a.?, &bt) orelse return null;
        if (bt.?.k != .Struct) { return null; }
        for (bt.?.fields.items) |*f| {
            if (text.eq(f.name, x.name)) {
                t.* = f.t;
                return v;
            }
        }
        return null;
    }
    if (x.k == .Index) {
        let v = localRoot(x.a.?, &bt) orelse return null;
        if (!ty.isArray(bt.?)) { return null; }
        t.* = bt.?.elem;
        return v;
    }
    return null;
}

fn hasBreak(blk: *ast.Node) -> bool {
    for (blk.list.items) |s| {
        if (s.k == .Break) { return true; }
        if (s.k == .Switch) {
            for (s.list.items) |arm| {
                let body = arm.a.?;
                if (body.k == .Break || (body.k == .Block && hasBreak(body))) { return true; }
            }
        }
        if (s.k == .If && (hasBreak(s.b.?) || (s.c != null && hasBreak(s.c.?)))) { return true; }
        if (s.k == .Block && hasBreak(s)) { return true; }
    }
    return false;
}

pub fn alwaysReturns(blk: *ast.Node) -> bool {
    for (blk.list.items) |s| {
        if (s.k == .Return) { return true; }
        if (s.k == .If && s.c != null && alwaysReturns(s.b.?) && alwaysReturns(s.c.?)) { return true; }
        if (s.k == .Block && alwaysReturns(s)) { return true; }
        if (s.k == .Switch && s.flag == 0) { // switches are exhaustive, so: every case returns
            var all = true;
            for (s.list.items) |arm| {
                if (!all) { break; }
                if (cases.armEndsWithFallthrough(arm)) { continue; }
                all = arm.a.?.k == .Return || (arm.a.?.k == .Block && alwaysReturns(arm.a.?));
            }
            if (all) { return true; }
        }
        if (s.k == .While && s.a.?.k == .Bool && s.a.?.ival != 0 && !hasBreak(s.b.?)) { return true; }
        if (s.k == .ExprStmt) {
            let e = s.a.?;
            if (e.k == .Call && e.a.?.k == .Name && (text.eq(e.a.?.name, "exit") || text.eq(e.a.?.name, "panic"))) { return true; }
            if (e.k == .Unreachable) { return true; }
            if (e.k == .Call) { // a call of a function that returns noreturn
                let callee = e.a.?;
                let f = if (callee.k == .Name && names.findVar(callee.name) == null) names.findFn(callee.name) else members.calleeFn(callee);
                if (f) |fi| { if (fi.ret == ty.noreturn_) { return true; } }
            }
        }
    }
    return false;
}

pub fn stmt(n: *ast.Node) {
    let su = st.CU;
    let stok = st.CUR_TOK;
    if (n.unit) |u| { st.CU = u; }
    st.CUR_TOK = n.tok;
    stmtIn(n);
    st.CU = su;
    st.CUR_TOK = stok;
}

fn letStmt(n: *ast.Node) {
    let cx = st.c();
    if (n.count() > 0) { // let (a, b) = tuple;
        let tt = if (n.a) |a| names.resolve(a) else null;
        var tv = expr.expr(n.b.?, tt);
        if (tt) |t| { tv = cv.coerce(tv, t, n.b.?.tok, "the destructured value"); }
        if (tv.t.k != .Struct || !tv.t.tuple) {
            diag.at(n.b.?.tok, text.f("only tuples can be destructured, but this is {s}", .{ty.tname(tv.t)}));
        }
        ty.layout(tv.t, n.tok);
        if (tv.t.fields.items.len != n.count()) {
            diag.at(n.tok, text.f("{s} has {} elements, but {} names are given", .{ty.tname(tv.t), tv.t.fields.items.len, n.count()}));
        }
        if (!tv.fresh) { // copy first: the names may shadow what the value came from
            let c = b.temp(tv.t);
            b.copyAgg(tv.t, c, tv.a);
            tv = b.vAgg(tv.t, c, true);
        }
        for (0..n.count()) |i| {
            let nm = n.at(i);
            if (text.eq(nm.name, "_")) { continue; }
            let fd = &tv.t.fields.items[i];
            let var_ = newLocal(nm.name, fd.t, nm.tok, n.flag != 0);
            b.storeVal(fd.t, b.aSlot(var_.slot, 0), b.loadVal(fd.t, b.aAdd(tv.a, fd.off as i64)));
        }
        return;
    }
    var t: ?*ty.Type = null;
    var v = b.vVoid();
    let type_ann = n.a != null && n.a.?.k == .TName && text.eq(n.a.?.name, "type"); // let T: type = ...
    if (type_ann) {
        t = ty.type_;
    } else if (n.a) |a| {
        let rt = names.resolve(a);
        ty.layout(rt, a.tok);
        t = rt;
    }
    if (n.b != null && n.b.?.k == .Undefined) {
        if (n.flag != 0) { diag.at(n.b.?.tok, "a 'let' needs a real value; 'undefined' is only for 'var'"); }
        let tt = t orelse diag.at(n.tok, text.f("'{s}' needs a type to be undefined: 'var {s}: T = undefined;'", .{n.name, n.name}));
        let lv = newLocal(n.name, tt, n.tok, false);
        b.undefinedAt(tt, b.aSlot(lv.slot, 0));
        return;
    }
    let ct_fn = if (cx.fn_) |f| f.ct_fn else false;
    if (n.b) |init| {
        // in a function that only runs at compile time, a let made of compile-time-known names is known now
        if (ct_fn && n.flag != 0 && refsOnlyComptime(init)) {
            v = ctexec.ctEval(init, t, text.f("'{s}'", .{n.name}));
        } else {
            v = expr.expr(init, t);
        }
        if (t) |tt| { v = cv.coerce(v, tt, init.tok, text.f("'{s}'", .{n.name})); }
        if (v.t == ty.type_) { // let T = List(i32); a name for a type
            if (n.flag == 0) { diag.at(n.tok, text.f("'{s}' would hold a type, which only exists at compile time: use 'let {s} = ...;'", .{n.name, n.name})); }
            if (!v.isconst) { diag.at(init.tok, "a type must be known at compile time"); }
            declareTypeAlias(n.name, ty.typeFromId(v.ival).?, n.tok);
            return;
        }
        let ct_init = ct_fn || init.k == .Comptime; // let n = comptime f(); is a constant
        if (ct_init && n.flag != 0 && v.isconst && !ty.isAgg(v.t) && v.t != ty.null_) {
            declareConst(n.name, v, n.tok); // usable in types: [n]u8
            return;
        }
        if (v.t == ty.null_) { diag.at(n.tok, text.f("can't infer the type of '{s}' from null; write 'let {s}: *T = null'", .{n.name, n.name})); }
        if (v.t == ty.void_) { diag.at(init.tok, "that expression doesn't produce a value"); }
        if (ty.isLit(v.t)) { // an untyped number
            if (n.flag == 0) {
                diag.at(n.tok, text.f("give '{s}' a type: 'var {s}: {s} = ...;' (an untyped number is a compile-time constant)",
                                      .{n.name, n.name, if (v.t.k == .LitInt) "i64" else "f64"}));
            }
            declareConst(n.name, v, n.tok);
            return;
        }
        t = v.t;
    }
    let tt = t.?;
    if (ty.isAgg(tt) && n.b != null && v.fresh && v.a.slot >= 0 && v.a.off == 0) {
        let var_ = names.declare(n.name, tt, n.tok, n.flag != 0); // adopt the temporary
        var_.kind = .Slot;
        var_.slot = v.a.slot;
        return;
    }
    if (n.b == null) {
        let var_ = newLocal(n.name, tt, n.tok, n.flag != 0);
        b.zeroAt(tt, b.aSlot(var_.slot, 0));
        return;
    }
    if (!ty.isAgg(tt)) { v = b.vReg(tt, b.regOf(v)); } // evaluate before the name comes into scope
    let var_ = newLocal(n.name, tt, n.tok, n.flag != 0);
    b.storeVal(tt, b.aSlot(var_.slot, 0), v);
}

fn stmtIn(n: *ast.Node) {
    let cx = st.c();
    switch (n.k) {
        .Let => { letStmt(n); }
        .Assign => {
            let simple = text.eq(n.name, "=");
            let target = n.a.?;
            let l = access.lval(target);
            if (l.ro) {
                if (target.k == .Name) {
                    diag.at(target.tok, text.f("can't assign to '{s}': it's immutable (use 'var' to declare a mutable variable)", .{target.name}));
                }
                diag.at(n.tok, "can't assign here: the location is read-only");
            }
            if (l.temp) { diag.at(n.tok, "can't assign to a field of a temporary value"); }
            if (simple) {
                let v = cv.coerce(expr.expr(n.b.?, l.t), l.t, n.b.?.tok, "assignment");
                access.lvStore(l, v, n.b.?.tok);
                return;
            }
            let op = n.name[0..n.name.len - 1];
            if (ty.isAgg(l.t) && !ty.isVector(l.t)) {
                diag.at(n.tok, text.f("'{s}' needs a number{s}", .{n.name,
                    if (ty.isBytes(l.t) && text.eq(op, "+")) " ('+=' doesn't append to strings, since that would allocate: use an ArrayList(u8) or fmt.bufPrint)" else ""}));
            }
            let cur = access.lvLoad(l);
            let r = expr.expr(n.b.?, l.t);
            var res = ops.binop(op, cur, r, n.tok);
            res = cv.coerce(res, l.t, n.b.?.tok, "assignment");
            access.lvStore(l, res, n.b.?.tok);
        }
        .Incr => {
            let l = access.lval(n.a.?);
            if (l.ro) { diag.at(n.a.?.tok, "can't modify an immutable value"); }
            if (l.temp) { diag.at(n.tok, "can't modify a field of a temporary value"); }
            if (!ty.isInt(l.t) && !ty.isPtr(l.t)) { diag.at(n.tok, text.f("'{s}' needs an integer or pointer, found {s}", .{n.name, ty.tname(l.t)})); }
            let cur = access.lvLoad(l);
            let res = ops.binop(if (n.name[0] == '+') "+" else "-", cur, b.vInt(ty.litint, 1), n.tok);
            access.lvStore(l, res, n.tok);
        }
        .ExprStmt => {
            let v = expr.expr(n.a.?, null);
            if (v.t.k == .ErrUnion) {
                diag.at(n.tok, text.f("this can fail ({s}) and the error is ignored; handle it with 'try' or 'catch'", .{ty.tname(v.t)}));
            }
            if (v.t != ty.void_ && v.t != ty.noreturn_) {
                diag.at(n.tok, text.f("unused value of type {s}; write '_ = ...;' to discard it", .{ty.tname(v.t)}));
            }
        }
        .Discard => {
            let v = expr.expr(n.a.?, null);
            if (v.t.k == .ErrUnion) { diag.at(n.tok, "'_ =' can't throw away an error; write 'catch {}' to ignore it on purpose"); }
        }
        .Switch => { _ = cases.lowerSwitch(n, null); }
        .Comptime => { ctexec.ctBlock(n.a.?); }
        .Asm => { asmblock.lower(n); }
        .Fallthrough => { diag.at(n.tok, "fallthrough must be the last statement of a switch case"); }
        .Block => {
            let u: i32 = if (n.is_unsafe) 1 else 0;
            cx.unsafe_depth += u;
            subBlock(n, false, -1, -1);
            cx.unsafe_depth -= u;
        }
        .If => { ifStmt(n); }
        .While => { whileStmt(n); }
        .ForRange => { forRange(n); }
        .ForEach => { forEach(n); }
        .Return => { returnStmt(n); }
        .Break, .Continue => {
            var sc = cx.cur;
            while (sc) |s| {
                if (s.loop && (n.label.len == 0 || (s.label.len > 0 && text.eq(s.label, n.label)))) { break; }
                sc = s.parent;
            }
            if (sc == null && n.label.len > 0) { diag.at(n.tok, text.f("no enclosing loop is labeled '{s}'", .{n.label})); }
            let s = sc orelse diag.at(n.tok, text.f("'{s}' outside of a loop", .{if (n.k == .Break) "break" else "continue"}));
            emitDefers(s);
            b.jmp(if (n.k == .Break) s.brk else s.cont);
        }
        .Defer => {
            let f = cx.fn_.?;
            if (n.flag != 0 && (f.ret == null || f.ret.?.k != .ErrUnion)) {
                diag.at(n.tok, text.f("errdefer only runs when an error is returned, but '{s}' doesn't return an error union", .{f.name}));
            }
            let d = n.a.?;
            if (d.k == .Block) {
                for (d.list.items) |x| {
                    if (x.k == .Return || x.k == .Break || x.k == .Continue) {
                        diag.at(x.tok, "return/break/continue are not allowed inside defer");
                    }
                }
            }
            cx.cur.?.defers.push(n);
        }
        else => { diag.at(n.tok, "unexpected statement"); }
    }
}

fn ifStmt(n: *ast.Node) {
    let cnd = n.a.?;
    if (cnd.k == .Comptime && n.name.len == 0 && n.name2.len == 0) { // if (comptime c): only the taken branch is compiled
        let take = ctbranch.comptimeCond(cnd);
        let yes = if (take) n.b else n.c;
        let no = if (take) n.c else n.b;
        if (no) |x| { ctbranch.checkNames(x); }
        if (yes) |y| { subBlock(y, false, -1, -1); } // (an `else if` is a block holding the next if)
        return;
    }
    let tb = b.newBlock();
    let eb = if (n.c != null) b.newBlock() else -1;
    let join = b.newBlock();
    var ov = b.vVoid();
    let caps = n.name.len > 0 || n.name2.len > 0;
    var loc = access.newLV();
    if (caps) { // if (maybe) |v| { ... } else |err| { ... }
        ov = optional.capSubjectAt(cnd, n.name, n.name2, if (n.flag2 != 0) &loc else null);
        b.br(b.R(optional.capOk(ov)), tb, if (n.c != null) eb else join);
    } else {
        expr.cond(cnd, tb, if (n.c != null) eb else join);
    }
    b.setBlk(tb);
    names.pushScope(false, -1, -1);
    if (n.name.len > 0 && n.flag2 != 0) {
        optional.bindPtr(n.name, n.tok, loc);
    } else if (n.name.len > 0) {
        optional.bindOpt(n.name, n.tok, ov);
    }
    subBlock(n.b.?, false, -1, -1);
    names.popScope();
    b.jmp(join);
    if (n.c) |els| {
        b.setBlk(eb);
        names.pushScope(false, -1, -1);
        if (n.name2.len > 0) { optional.bindErr(n.name2, n.tok, ov); }
        subBlock(els, false, -1, -1);
        names.popScope();
        b.jmp(join);
    }
    b.setBlk(join);
}

fn whileStmt(n: *ast.Node) {
    let cx = st.c();
    if (n.name.len > 0) { // while (next()) |v| { ... }: test at the top, every time
        let head = b.newBlock();
        let body = b.newBlock();
        let exit_ = b.newBlock();
        b.jmp(head);
        b.setBlk(head);
        var loc = access.newLV();
        let ov = optional.capSubjectAt(n.a.?, n.name, "", if (n.flag2 != 0) &loc else null);
        b.br(b.R(optional.capOk(ov)), body, exit_);
        b.setBlk(body);
        names.pushScope(true, exit_, head);
        cx.cur.?.label = n.label;
        if (n.flag2 != 0) { optional.bindPtr(n.name, n.tok, loc); } else { optional.bindOpt(n.name, n.tok, ov); }
        blockBody(n.b.?);
        names.popScope();
        b.jmp(head);
        b.setBlk(exit_);
        return;
    }
    // rotated loop: test once up front, then at the bottom of each iteration
    let body = b.newBlock();
    let cont = b.newBlock();
    let exit_ = b.newBlock();
    expr.cond(n.a.?, body, exit_);
    b.setBlk(body);
    names.pushScope(true, exit_, cont);
    cx.cur.?.label = n.label;
    blockBody(n.b.?);
    names.popScope();
    b.jmp(cont);
    b.setBlk(cont);
    expr.cond(n.a.?, body, exit_);
    b.setBlk(exit_);
}

fn forRange(n: *ast.Node) {
    let cx = st.c();
    var a = expr.expr(n.a.?, null);
    var c = expr.expr(n.b.?, if (ty.isLit(a.t)) null else a.t);
    var t = cv.unify(a.t, c.t, n.tok, "..");
    if (t.k == .LitInt) { // for (0..n) counts in usize, like lengths; negative bounds count in i64
        t = if ((a.isconst && a.ival < 0) || (c.isconst && c.ival < 0)) ty.i64_ else ty.usize_;
    }
    t = ty.defaultT(t);
    if (!ty.isInt(t)) { diag.at(n.a.?.tok, text.f("range bounds must be integers, found {s}", .{ty.tname(t)})); }
    a = cv.coerce(a, t, n.a.?.tok, "range start");
    c = cv.coerce(c, t, n.b.?.tok, "range end");
    let end = if (c.isconst) b.IMM(c.ival) else b.R(b.regOf(c));
    let start = b.opdOf(a);
    let sg = ty.isSigned(t);
    let lt: ir.CC = if (n.flag != 0) (if (sg) .LE else .LS) else (if (sg) .LT else .LO);
    let body = b.newBlock();
    let step = b.newBlock();
    let exit_ = b.newBlock();
    names.pushScope(true, exit_, step);
    cx.cur.?.label = n.label;
    let iv = newLocal(n.name, t, n.tok, true);
    let islot = iv.slot;
    b.store(t, b.aSlot(islot, 0), start);
    b.br(b.R(b.cmp(lt, if (start.k == .Imm) b.R(b.iconst(start.v)) else start, end)), body, exit_);
    b.setBlk(body);
    blockBody(n.c.?);
    b.jmp(step);
    b.setBlk(step);
    var i2 = b.op2(.Add, .I, b.R(b.load(t, b.aSlot(islot, 0))), b.IMM(1));
    i2 = cv.norm(i2, t);
    b.store(t, b.aSlot(islot, 0), b.R(i2));
    b.br(b.R(b.cmp(lt, b.R(i2), end)), body, exit_);
    names.popScope();
    b.setBlk(exit_);
}

fn forEach(n: *ast.Node) {
    let cx = st.c();
    var et: *ty.Type = undefined;
    var p: i32 = 0;
    var len: i32 = 0;
    var ro = false;
    var s: b.Val = undefined;
    let seq = n.a.?;
    if (access.isLvalueNode(seq)) { // arrays are looped over in place, so |*x| changes them
        let l = access.lval(seq);
        access.unionRead(l);
        s = if (ty.isArray(l.t)) b.vAgg(l.t, l.a, false) else b.loadVal(l.t, l.a);
        ro = l.ro || l.temp;
    } else {
        s = expr.expr(seq, null);
        ro = true;
    }
    if (ty.isArrayPtr(s.t)) {
        ro = s.t.is_const;
        s = b.vAgg(s.t.E(), b.aReg(b.regOf(s), 0), false);
    }
    if (ty.isArray(s.t)) {
        ty.layout(s.t, seq.tok);
        et = s.t.E();
        p = b.addrReg(s.a);
        len = b.iconst(s.t.alen);
    } else {
        if (ty.isSlice(s.t)) {
            et = s.t.E();
            ro = s.t.is_const;
        } else {
            diag.at(seq.tok, text.f("can't loop over {s} (use an array, a slice, or a range a..b)", .{ty.tname(s.t)}));
        }
        p = b.load(ty.ptrTo(et), s.a);
        len = b.load(ty.i64_, b.aAdd(s.a, 8));
    }
    let body = b.newBlock();
    let step = b.newBlock();
    let exit_ = b.newBlock();
    names.pushScope(true, exit_, step);
    cx.cur.?.label = n.label;
    let islot = if (n.name2.len > 0) newLocal(n.name2, ty.usize_, n.tok, true).slot else b.newSlot(ty.usize_);
    b.store(ty.i64_, b.aSlot(islot, 0), b.IMM(0));
    b.br(b.R(b.cmp(.GT, b.R(len), b.IMM(0))), body, exit_);
    b.setBlk(body);
    let i = b.load(ty.i64_, b.aSlot(islot, 0));
    let ea = access.elemAddr(p, b.vReg(ty.i64_, i), et.size);
    if (n.flag != 0) { // |*x|: x points at the element
        let pt = ty.ptrToQ(et, ro);
        let v = newLocal(n.name, pt, n.tok, true);
        b.store(pt, b.aSlot(v.slot, 0), b.R(b.addrReg(ea)));
    } else if (ty.isAgg(et)) { // alias the element in place (read-only)
        let v = names.declare(n.name, et, n.tok, true);
        v.kind = .Ref;
        v.reg = b.addrReg(ea);
    } else {
        let v = newLocal(n.name, et, n.tok, true);
        b.store(et, b.aSlot(v.slot, 0), b.R(b.load(et, ea)));
    }
    blockBody(n.c.?);
    b.jmp(step);
    b.setBlk(step);
    let i2 = b.op2(.Add, .I, b.R(b.load(ty.i64_, b.aSlot(islot, 0))), b.IMM(1));
    b.store(ty.i64_, b.aSlot(islot, 0), b.R(i2));
    b.br(b.R(b.cmp(.LT, b.R(i2), b.R(len))), body, exit_);
    names.popScope();
    b.setBlk(exit_);
}

fn returnStmt(n: *ast.Node) {
    let cx = st.c();
    let f = cx.fn_.?;
    if (cx.ct_scratch) { diag.at(n.tok, "'return' can't leave a comptime expression or block"); }
    if (n.a) |a| {
        if ((a.k == .Unary && text.eq(a.name, "&")) || a.k == .Slice) {
            var rt: ?*ty.Type = null;
            if (localRoot(a.a.?, &rt)) |lv| {
                if (a.k == .Unary || ty.isArray(rt.?)) {
                    diag.at(a.tok, text.f("this returns a pointer to the local '{s}', which is gone once the function returns", .{lv.name}));
                }
            }
        }
    }
    let a = n.a orelse {
        if (f.ret == null) { f.ret = ty.void_; }
        let fr = f.ret.?;
        let ok_void = fr.k == .ErrUnion && fr.E() == ty.void_; // `return;` in !void: success
        if (fr != ty.void_ && !ok_void) { diag.at(n.tok, text.f("function '{s}' must return a {s}", .{f.name, ty.tname(fr)})); }
        emitDefers(null);
        errors.retInst(b.IMM(0));
        return;
    };
    var v = expr.expr(a, f.ret);
    if (f.ret == null && v.t.k == .ErrSet) { diag.at(a.tok, "a function that returns errors needs a declared return type, like -> !T"); }
    if (f.ret == null) {
        if (v.t == ty.null_ || v.t == ty.void_) { diag.at(a.tok, "can't infer the return type here; add '-> type' to the function"); }
        f.ret = ty.defaultT(v.t);
        if (ty.isAgg(f.ret.?)) { program.addRetptr(); }
    }
    let fr = f.ret.?;
    if (fr == ty.void_) { diag.at(a.tok, text.f("function '{s}' returns nothing, but a value is returned here", .{f.name})); }
    // 0: success, 1: an error, 2: an error union that may hold either
    let kind: i32 = if (fr.k != .ErrUnion) 0 else if (v.t.k == .ErrSet) 1 else if (v.t.k == .ErrUnion) 2 else 0;
    v = cv.coerce(v, fr, a.tok, "return value");
    let code = if (kind != 0) cv.euErr(v) else b.IMM(0);
    var o = b.IMM(0);
    if (ty.isAgg(fr)) { b.copyAgg(fr, b.aReg(cx.retptr, 0), v.a); } else { o = b.opdOf(v); }
    if (kind == 0) {
        emitDefers(null);
    } else {
        var e = if (code.k == .Imm) b.vInt(fr.eset.?, code.v) else b.vReg(fr.eset.?, code.v as i32);
        if (kind == 2) {
            let eb = b.newBlock();
            let nb = b.newBlock();
            b.br(b.R(b.cmp(.NE, code, b.IMM(0))), eb, nb);
            b.setBlk(eb);
            emitDefersErr(null, &e);
            errors.retInst(o);
            b.setBlk(nb);
            emitDefers(null);
        } else {
            emitDefersErr(null, &e);
        }
    }
    errors.retInst(o);
}
