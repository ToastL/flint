// sema.state - the records lowering works with (functions, variables, scopes, generic instances,
// comptime bindings) and the state of the compile in progress. This is the one place sema keeps
// state; every other sema module reads and changes it through `st.`.

import base.alloc;
import syntax.token;
import syntax.ast;
import modules.unit;
import ir.ir;
import sema.types;

// Compile-time bindings while lowering a generic instance: comptime T: type binds a type, a
// comptime value parameter binds a constant. Instances of `-> type` functions also bind Self.
pub struct Binding {
    name: []const u8,
    type_: ?*types.Type, // a type binding, or null for a value
    vt: ?*types.Type,    // a value binding: its type
    ival: i64,
    fval: f64,
    sdata: ?[]const u8,  // a string value
    var_: ?*Var,         // a value binding: the Var that names it
}

pub struct TEnv {
    parent: ?*TEnv,
    b: alloc.Vec(*Binding),
}

// one instance of a generic function: the comptime arguments (and anytype argument types) it was made for
pub struct KeyPart {
    t: ?*types.Type,  // a type argument, or an anytype argument's type
    vt: ?*types.Type, // a value argument's type
    ival: i64,
    fval: f64,
    sdata: ?[]const u8,
}

pub struct GenInst {
    key: []KeyPart,
    fn_: ?*FnInfo,       // the instance (generic functions)
    type_: ?*types.Type, // the type it made (`-> type` functions)
}

pub struct FnInfo {
    name: []const u8,
    decl: ?*ast.Node,
    recv: ?*types.Type,
    pt: alloc.Vec(*types.Type),
    pn: alloc.Vec([]const u8),
    ptok: alloc.Vec(*token.Token),
    ret: ?*types.Type, // null while being inferred
    ext: bool,
    variadic: bool,
    self_kind: i32,
    sym: []const u8,
    state: i32,     // 0 = todo, 1 = lowering, 2 = done
    lib: bool,      // from the standard library: lowered only if used
    lazy: bool,     // a method of a generic type's instance: lowered only if used
    generic: bool,  // has comptime or anytype parameters: each call site picks an instance
    type_fn: bool,  // returns `type`: called at compile time to make a type
    ct_fn: bool,    // an instance of a type function: it only ever runs at compile time
    tenv: ?*TEnv,   // the bindings its body sees (an instance, or a method of a generic type)
    unit: ?*unit.Unit, // the module that declares it
    is_pub: bool,
    insts: alloc.Vec(*GenInst), // instances made so far (generic functions)

    pub fn np(self: *const FnInfo) -> usize { return self.pt.items.len; }
}

pub enum VK { Slot, Ref, Global, Const, CStr, Lazy, Type } // Type: let T = u8; (t is the type)

pub struct Var {
    name: []const u8,
    t: ?*types.Type,
    kind: VK,
    slot: i32,
    reg: i32,
    sym: []const u8,
    is_const: bool,
    cival: i64,
    cfval: f64,
    ext: bool,         // Global defined in C: reached through the GOT
    param_copy: bool,  // Ref: an aggregate parameter (the callee's own copy)
    sdata: []const u8, // CStr: a compile-time string (a comptime []const u8 parameter)
    origin: ?*token.Token, // CStr: where the string was written (errors about a format string point there)
    lazy: ?*ast.Node,  // Lazy: a global, set up the first time it's used (or at the end)
    lazy_owner: ?*types.Type,
    lazy_te: ?*TEnv,   // Lazy: the comptime bindings its initializer sees (a generic type's let)
    busy: bool,        // Lazy: being set up now (so a use means it depends on itself)
    unit: ?*unit.Unit, // globals: the module that declares it
    is_pub: bool,
}

pub struct Scope {
    parent: ?*Scope,
    vars: alloc.Vec(*Var),
    defers: alloc.Vec(*ast.Node),
    loop: bool,
    brk: i32,
    cont: i32,
    label: []const u8,
    unsafe_depth: i32, // defers run with the unsafe-ness of the scope they were declared in
}

pub struct Ctx {
    f: *ir.IRFunc,
    fn_: ?*FnInfo,
    blk: i32,
    cur: ?*Scope,
    retptr: i32,
    seq: i32,
    unsafe_depth: i32, // inside `unsafe { }` or an `unsafe fn` body
    defer_depth: i32,  // lowering a defer's body: it can't leave the function
    ct_scratch: bool,  // a comptime expression or block: it runs once, now, and can't return
    outer: ?*Ctx,      // ... and the function it was written in (its constants are visible)
}

// ---- the state of the compile ----

pub var TE: ?*TEnv = null;          // the bindings in effect (null outside generic code)
pub var CU: ?*unit.Unit = null;     // the module whose code is being looked at: names resolve in it
pub var UNITS: []*unit.Unit = @zeroes([]*unit.Unit); // every module of the program
pub var G_ONLY: bool = false;       // looking up a module's member: skip the caller's local variables
pub var C: ?*Ctx = null;            // the function being lowered
pub var M: *ir.Module = undefined;
pub var MODE: ir.Mode = .Debug;
pub var CUR_TOK: ?*token.Token = null; // the node being lowered; instructions remember it
pub var structs: alloc.Vec(*types.Type) = @zeroes(alloc.Vec(*types.Type));
pub var fns: alloc.Vec(*FnInfo) = @zeroes(alloc.Vec(*FnInfo));
pub var gvars: alloc.Vec(*Var) = @zeroes(alloc.Vec(*Var));

// the current function (there must be one)
pub fn c() -> *Ctx { return C.?; }

// the current module (there must be one)
pub fn cu() -> *unit.Unit { return CU.?; }

pub fn inUnsafe() -> bool {
    if (C) |cx| { return cx.unsafe_depth > 0; }
    return false;
}

// overflow checks: Debug and ReleaseSafe, outside unsafe blocks
pub fn safeArith() -> bool { return MODE != .Fast && !inUnsafe(); }

// bounds checks: every mode, outside unsafe blocks
pub fn boundsChecked() -> bool { return !inUnsafe(); }
