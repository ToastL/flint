// driver.dumps - `flint tokens` and `flint ast`: the lexer's and parser's output in a fixed text
// form, for comparing this compiler with another build of it (tests/diff.sh).

import std.io;
import std.fs;
import std.heap;
import base.alloc;
import base.diag;
import syntax.token;
import syntax.lex;
import syntax.ast;
import syntax.parser;
import syntax.parse_decl;
import modules.unit;

fn readOrDie(path: []const u8) -> []const u8 {
    let src = fs.readFile(heap.c_allocator, path) catch {
        _ = io.eprint("flint: can't read {s}\n", .{path}) catch {};
        exit(1);
    };
    diag.path = path;
    diag.src = src;
    return src;
}

let KINDS = [_][]const u8 { "id", "kw", "int", "float", "str", "op", "eof" };

pub fn tokens(path: []const u8) -> u8 {
    let src = readOrDie(path);
    for (lex.lex(src, path)) |*t| {
        _ = io.print("{}:{} {s}", .{t.line, t.col, KINDS[t.k as usize]}) catch {};
        switch (t.k) {
            .Int => { _ = io.print(" {}", .{t.ival}) catch {}; }
            .Float => { _ = io.print(" {}", .{t.fval}) catch {}; }
            .Str => {
                _ = io.print(" {} ", .{t.str.len}) catch {};
                for (t.str) |b| { _ = io.print("{x:0>2}", .{b}) catch {}; }
            }
            else => { _ = io.print(" {s}", .{t.s}) catch {}; }
        }
        _ = io.print("\n", .{}) catch {};
    }
    return 0;
}

fn indent(d: i32) {
    var i: i32 = 0;
    while (i < d) {
        _ = io.print("  ", .{}) catch {};
        i += 1;
    }
}

fn node(m: ?*ast.Node, d: i32) {
    indent(d);
    if (m == null) {
        _ = io.print("-\n", .{}) catch {};
        return;
    }
    let n = m.?;
    _ = io.print("{} @{}:{}", .{n.k as i32, n.tok.line, n.tok.col}) catch {};
    if (n.name.len > 0) { _ = io.print(" n={s}", .{n.name}) catch {}; }
    if (n.name2.len > 0) { _ = io.print(" n2={s}", .{n.name2}) catch {}; }
    if (n.label.len > 0) { _ = io.print(" l={s}", .{n.label}) catch {}; }
    if (n.ival != 0) { _ = io.print(" i={}", .{n.ival}) catch {}; }
    if (n.fval != 0.0) { _ = io.print(" f={}", .{n.fval}) catch {}; }
    if (n.k == .Str || n.k == .Test) {
        _ = io.print(" s=", .{}) catch {};
        for (n.str) |b| { _ = io.print("{x:0>2}", .{b}) catch {}; }
    }
    if (n.flag != 0) { _ = io.print(" f1={}", .{n.flag}) catch {}; }
    if (n.flag2 != 0) { _ = io.print(" f2={}", .{n.flag2}) catch {}; }
    if (n.exported || n.is_extern || n.is_unsafe || n.is_pub) {
        _ = io.print(" b={}{}{}{}", .{n.exported as i32, n.is_extern as i32, n.is_unsafe as i32, n.is_pub as i32}) catch {};
    }
    _ = io.print("\n", .{}) catch {};
    if (n.a != null || n.b != null || n.c != null) {
        node(n.a, d + 1);
        node(n.b, d + 1);
        node(n.c, d + 1);
    }
    if (n.wherec) |w| { node(w, d + 1); }
    for (n.list.items) |c| { node(c, d + 1); }
}

// just this file, with its own type names
pub fn tree(path: []const u8) -> u8 {
    let src = readOrDie(path);
    let u = alloc.new(unit.Unit);
    u.path = "main";
    u.toks = lex.lex(src, path);
    let names = alloc.new(parser.Names);
    parse_decl.parseImports(u.toks, names, u);
    parse_decl.prescan(u.toks, names);
    parse_decl.parse(u.toks, names, u);
    for (u.imports.items) |*im| { _ = io.print("import {s} {s} {s}\n", .{im.alias, im.mpath, im.header}) catch {}; }
    for (u.items) |it| { node(it, 0); }
    return 0;
}
