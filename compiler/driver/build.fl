// driver.build - from assembly to a program, in two steps: assemble with the system assembler,
// then link with the C toolchain (for libc), together with the objects and libraries named on
// the command line. Then, maybe, run it.
//
// With --cache the steps' outputs stay in that directory, and a step whose inputs are the ones
// it last ran with is skipped (driver.cache). Without it the build happens in a temporary
// directory that's removed afterwards.
//
// The same program builds to the same bytes, wherever it's written: macOS's linker names the
// code signature after the output file, and the UUID is a hash of the contents, so the program
// is always linked under its own name (Job.name) and then moved to where it was asked for.

import std.fs;
import std.hash;
import std.process;
import base.alloc;
import base.text;
import base.cmdline;
import driver.cache;

extern fn rename(from: cstr, to: cstr) -> i32;

pub struct Job {
    name: []const u8,    // the program's name: the file it's linked as (see above)
    asm_text: []const u8,
    has_asm: bool, // some of it was written by hand, in asm blocks
    objects: []const []const u8, // --object: linked with the program
    libs: []const []const u8,    // --lib: -l<name> for the linker
    cache: []const u8,   // the directory the steps' outputs stay in ("": a temporary one)
    out: []const u8,     // the executable to write ("" for one in that directory)
    keep: bool,          // keep the executable
    run: bool,           // run it afterwards
    prog_args: []const []const u8,
}

// prog.s -> prog.o; the object's key, or null if the assembler failed (it said why)
fn assemble(j: *Job, dir: []const u8, cached: bool) -> ?[]const u8 {
    let spath = text.f("{s}/prog.s", .{dir});
    let opath = text.f("{s}/prog.o", .{dir});
    let kpath = text.f("{s}/prog.key", .{dir});
    let key = cache.hex(hash.bytes(j.asm_text));
    if (cached && fs.exists(opath) && text.eq(cache.read(kpath), key)) { return key; }
    if (cached) { fs.remove(kpath) catch {}; }
    fs.writeFile(spath, j.asm_text) catch {
        _ = cmdline.fail(text.f("can't write {s}", .{spath}), "");
        return null;
    };
    if (cmdline.run(&[_][]const u8 { "as", "-arch", "arm64", "-o", opath, spath }) != 0) {
        let kept = if (cached) text.f("the assembly is in {s}", .{spath}) else "FLINT_KEEP=1 keeps the file";
        if (j.has_asm) {
            _ = cmdline.fail(text.f("the assembler rejected the program: check the lines in its asm blocks ({s})", .{kept}), "");
        } else {
            _ = cmdline.fail(text.f("internal error: the generated assembly didn't assemble ({s})", .{spath}), "");
        }
        return null;
    }
    if (cached) { cache.write(kpath, key); }
    return key;
}

fn baseName(p: []const u8) -> []const u8 { return if (text.lastIndexOf(p, '/')) |s| p[s + 1..] else p; }

// prog.o and the objects -> the executable; false if the linker failed
fn link(j: *Job, dir: []const u8, cached: bool, prog_key: []const u8, exe: []const u8) -> bool {
    let direct = text.eq(baseName(exe), j.name);
    let target = if (direct) exe else text.f("{s}/{s}", .{dir, j.name});
    var ld: alloc.Vec([]const u8) = .{};
    ld.push("cc");
    ld.push("-o");
    ld.push(target);
    ld.push(text.f("{s}/prog.o", .{dir}));
    for (j.objects) |o| { ld.push(o); }
    for (j.libs) |l| { ld.push(text.f("-l{s}", .{l})); }
    let kpath = text.f("{s}/link.key", .{dir});
    var key: []const u8 = "";
    if (cached) { // the command, where it goes, the program, and what's in each object
        var h = cache.mix(cache.mix(cache.ofStrings(ld.items), exe), prog_key);
        for (j.objects) |o| { h = cache.mix(h, cache.ofFile(o)); }
        key = cache.hex(h);
        if (fs.exists(exe) && text.eq(cache.read(kpath), key)) { return true; }
        fs.remove(kpath) catch {};
    }
    if (cmdline.run(ld.items) != 0) {
        _ = cmdline.fail("linking failed", "");
        return false;
    }
    if (!direct && rename(text.z(target), text.z(exe)) != 0) {
        // another file system: copy it (cp keeps it executable)
        if (cmdline.run(&[_][]const u8 { "cp", target, exe }) != 0) {
            _ = cmdline.fail(text.f("can't write {s}", .{exe}), "");
            return false;
        }
        fs.remove(target) catch {};
    }
    if (cached) { cache.write(kpath, key); }
    return true;
}

// assembles, links and (maybe) runs; the exit status for the command
pub fn build(j: *Job) -> u8 {
    let cached = j.cache.len > 0;
    var dir = j.cache;
    if (cached) {
        if (!cache.makeDirs(dir)) { return cmdline.fail(text.f("can't create the directory {s}", .{dir}), ""); }
    } else {
        var tbuf: [64]u8 = undefined;
        let tdir = fs.makeTempDir("flint-", tbuf[..]) catch return cmdline.fail("can't create a temp directory", "");
        dir = alloc.dupe(u8, tdir);
    }
    let exe = if (j.out.len > 0) j.out else text.f("{s}/{s}", .{dir, j.name});
    let key = assemble(j, dir, cached) orelse return 1;
    if (!link(j, dir, cached, key, exe)) { return 1; }
    var status: u8 = 0;
    if (j.run) {
        var pargv: alloc.Vec([]const u8) = .{};
        pargv.push(exe);
        for (j.prog_args) |a| { pargv.push(a); }
        status = cmdline.run(pargv.items);
    }
    if (!cached && process.getEnv("FLINT_KEEP") == null) {
        fs.remove(text.f("{s}/prog.s", .{dir})) catch {};
        fs.remove(text.f("{s}/prog.o", .{dir})) catch {};
        if (!j.keep) { fs.remove(exe) catch {}; }
        fs.removeDir(dir) catch {};
    }
    return status;
}
