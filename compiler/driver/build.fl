// driver.build - from assembly to a program: assemble with the system assembler, compile the
// packages' C sources with the C compiler, link with the C toolchain (for libc), and run.

import std.io;
import std.fs;
import std.heap;
import std.process;
import base.alloc;
import base.text;
import modules.unit;
import modules.load;
import ir.ir;

// runs argv and returns its exit status (128 + the signal if it was killed; 127 if it couldn't start)
pub fn run(argv: []const []const u8) -> u8 {
    _ = io.flush() catch {};
    return process.run(heap.c_allocator, argv) catch {
        _ = io.eprint("flint: can't run {s}\n", .{argv[0]}) catch {};
        return 127;
    };
}

// every package the build uses: the root package and its dependencies, each once
fn collectPkgs(p: *unit.Package, out: *alloc.Vec(*unit.Package)) {
    for (out.items) |x| { if (x == p) { return; } }
    out.push(p);
    for (p.deps.items) |*d| { collectPkgs(d.pkg, out); }
}

pub struct Job {
    asm_text: []const u8,
    has_asm: bool, // some of it was written by hand, in asm blocks
    pkg: *unit.Package,
    mode: ir.Mode,
    out: []const u8,     // the executable to write ("" for a temporary one)
    keep: bool,          // build: keep the executable
    run: bool,           // run it afterwards
    prog_args: []const []const u8,
}

fn fail(msg: []const u8) -> u8 {
    _ = io.eprint("flint: {s}\n", .{msg}) catch {};
    return 1;
}

// assembles, links and (maybe) runs; the exit status for the flint command
pub fn build(j: *Job) -> u8 {
    var tbuf: [64]u8 = undefined;
    let tdir = fs.makeTempDir("flint-", tbuf[..]) catch return fail("can't create a temp directory");
    let dir = alloc.dupe(u8, tdir);
    let spath = text.f("{s}/prog.s", .{dir});
    let opath = text.f("{s}/prog.o", .{dir});
    fs.writeFile(spath, j.asm_text) catch return fail(text.f("can't write {s}", .{spath}));
    let exe = if (j.out.len > 0) j.out else text.f("{s}/prog", .{dir});
    if (run(&[_][]const u8 { "as", "-arch", "arm64", "-o", opath, spath }) != 0) {
        if (j.has_asm) { return fail("the assembler rejected the program: check the lines in its asm blocks (FLINT_KEEP=1 keeps the file)"); }
        return fail(text.f("internal error: the generated assembly didn't assemble ({s})", .{spath}));
    }
    var pkgs: alloc.Vec(*unit.Package) = .{};
    collectPkgs(j.pkg, &pkgs);
    var objs: alloc.Vec([]const u8) = .{};
    for (0..pkgs.items.len) |p| { // the packages' C sources, compiled by the C compiler
        let pk = pkgs.items[p];
        for (0..pk.csrc.items.len) |i| {
            let obj = text.f("{s}/c{}_{}.o", .{dir, p, i});
            var cc: alloc.Vec([]const u8) = .{};
            cc.push(load.cc);
            cc.push("-c");
            cc.push(if (j.mode == .Debug) "-O0" else "-O2");
            for (pk.cinc.items) |inc| { cc.push(text.f("-I{s}", .{inc})); }
            for (pk.cflags.items) |fl| { cc.push(fl); }
            cc.push(pk.csrc.items[i]);
            cc.push("-o");
            cc.push(obj);
            if (run(cc.items) != 0) { return fail(text.f("compiling {s} failed", .{pk.csrc.items[i]})); }
            objs.push(obj);
        }
    }
    var ld: alloc.Vec([]const u8) = .{};
    ld.push("cc");
    ld.push("-o");
    ld.push(exe);
    ld.push(opath);
    for (objs.items) |o| { ld.push(o); }
    for (pkgs.items) |pk| { for (pk.clink.items) |l| { ld.push(text.f("-l{s}", .{l})); } }
    if (run(ld.items) != 0) { return fail("linking failed"); }
    var status: u8 = 0;
    if (j.run) {
        var pargv: alloc.Vec([]const u8) = .{};
        pargv.push(exe);
        for (j.prog_args) |a| { pargv.push(a); }
        status = run(pargv.items);
    }
    if (process.getEnv("FLINT_KEEP") == null) {
        fs.remove(spath) catch {};
        fs.remove(opath) catch {};
        for (objs.items) |o| { fs.remove(o) catch {}; }
        if (!j.keep) { fs.remove(exe) catch {}; }
        fs.removeDir(dir) catch {};
    }
    return status;
}
