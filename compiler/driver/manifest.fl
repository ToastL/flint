// driver.manifest - flint.toml, the package manifest (design.md section 4.16)
//
//   [package]
//   name = "app"
//   root = "src/main.fl"            # the default
//
//   [dependencies]
//   geometry = { path = "../geometry" }
//
//   [c]                             # C code in the package, built with the C compiler
//   sources = ["c/fast.c"]
//   include = ["c"]
//   flags = ["-O2"]
//   link = ["m"]                    # -lm
//
// The format is a small subset of TOML: [tables], key = value, where a value is a "string", an
// integer, true/false, an array of strings, or an inline table of strings; # starts a comment.

import std.io;
import std.fs;
import std.heap;
import base.alloc;
import base.text;
import base.term;
import modules.unit;

struct TP {
    file: []const u8,
    src: []const u8,
    p: usize,
    line: i32,

    // the current byte (0 at the end)
    fn c(self: *Self) -> u8 { return if (self.p < self.src.len) self.src[self.p] else 0; }
}

fn bad(t: *TP, msg: []const u8) -> noreturn {
    _ = io.flush() catch {};
    _ = io.eprint("{s} {s}: {s}\n", .{term.bold(term.ERR, text.f("{s}:{}:", .{t.file, t.line})), term.label("error"), msg}) catch {};
    exit(1);
}

fn isAlnum(c: u8) -> bool { return (c >= '0' && c <= '9') || (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z'); }

fn skipWs(t: *TP) {
    while (t.c() == ' ' || t.c() == '\t' || t.c() == '\r') { t.p += 1; }
    if (t.c() == '#') {
        while (t.c() != 0 && t.c() != '\n') { t.p += 1; }
    }
}

// whitespace, comments and newlines (inside arrays and inline tables)
fn skipAll(t: *TP) {
    while (true) {
        skipWs(t);
        if (t.c() != '\n') { return; }
        t.p += 1;
        t.line += 1;
    }
}

fn key(t: *TP) -> []const u8 {
    let s = t.p;
    while (t.c() != 0 && (isAlnum(t.c()) || t.c() == '_' || t.c() == '-')) { t.p += 1; }
    if (t.p == s) { bad(t, "expected a key"); }
    return t.src[s..t.p];
}

fn string(t: *TP) -> []const u8 {
    if (t.c() != '"') { bad(t, "expected a \"string\""); }
    t.p += 1;
    var out: text.Buf = .{};
    while (t.c() != '"') {
        if (t.c() == 0 || t.c() == '\n') { bad(t, "unterminated string"); }
        if (t.c() == '\\') {
            t.p += 1;
            let c = t.c();
            out.byte(if (c == 'n') '\n' else if (c == 't') '\t' else c);
            t.p += 1;
            continue;
        }
        out.byte(t.c());
        t.p += 1;
    }
    t.p += 1;
    return out.items;
}

enum VKind { Str, Int, Bool, Arr, Table }

struct Value {
    k: VKind,
    s: []const u8,
    i: i64,
    arr: alloc.Vec([]const u8),  // Arr: strings
    keys: alloc.Vec([]const u8), // Table: key = "string" pairs
    vals: alloc.Vec([]const u8),
}

fn startsHere(t: *TP, w: []const u8) -> bool { return text.startsWith(t.src[t.p..], w); }

fn value(t: *TP) -> *Value {
    let v = alloc.new(Value);
    if (t.c() == '"') {
        v.k = .Str;
        v.s = string(t);
    } else if (t.c() == '[') {
        v.k = .Arr;
        t.p += 1;
        skipAll(t);
        while (t.c() != ']') {
            v.arr.push(string(t));
            skipAll(t);
            if (t.c() == ',') {
                t.p += 1;
                skipAll(t);
            } else if (t.c() != ']') {
                bad(t, "expected ',' or ']' in the array");
            }
        }
        t.p += 1;
    } else if (t.c() == '{') {
        v.k = .Table;
        t.p += 1;
        skipWs(t);
        while (t.c() != '}') {
            let k = key(t);
            skipWs(t);
            if (t.c() != '=') { bad(t, text.f("expected '=' after '{s}'", .{k})); }
            t.p += 1;
            skipWs(t);
            v.keys.push(k);
            v.vals.push(string(t));
            skipWs(t);
            if (t.c() == ',') {
                t.p += 1;
                skipWs(t);
            } else if (t.c() != '}') {
                bad(t, "expected ',' or '}' in the inline table");
            }
        }
        t.p += 1;
    } else if (startsHere(t, "true") || startsHere(t, "false")) {
        v.k = .Bool;
        let yes = t.c() == 't';
        v.i = if (yes) 1 else 0;
        t.p += if (yes) 4 else 5;
    } else if ((t.c() >= '0' && t.c() <= '9') || t.c() == '-') {
        v.k = .Int;
        var neg = false;
        if (t.c() == '-') {
            neg = true;
            t.p += 1;
        }
        var n: i64 = 0;
        while (t.c() >= '0' && t.c() <= '9') {
            n = n *% 10 +% (t.c() - '0') as i64;
            t.p += 1;
        }
        v.i = if (neg) 0 -% n else n;
    } else {
        bad(t, "expected a value: a \"string\", a number, true/false, [array] or { table }");
    }
    return v;
}

fn tableGet(v: *Value, k: []const u8) -> ?[]const u8 {
    for (0..v.keys.items.len) |i| { if (text.eq(v.keys.items[i], k)) { return v.vals.items[i]; } }
    return null;
}

fn joinPath(dir: []const u8, p: []const u8) -> []const u8 {
    if (p.len > 0 && p[0] == '/') { return p; }
    return text.f("{s}/{s}", .{dir, p});
}

// the absolute path, or p itself if it doesn't exist
pub fn real(p: []const u8) -> []const u8 {
    var buf: [1024]u8 = undefined;
    let r = fs.realPath(p, buf[..]) catch return p;
    return alloc.dupe(u8, r);
}

var loaded: alloc.Vec(*unit.Package) = @zeroes(alloc.Vec(*unit.Package));

fn strList(t: *TP, v: *Value, what: []const u8) -> []const []const u8 {
    if (v.k != .Arr) { bad(t, text.f("'{s}' must be an array of strings", .{what})); }
    return v.arr.items;
}

pub fn read(dir0: []const u8) -> *unit.Package {
    let dir = real(dir0);
    for (loaded.items) |l| { if (text.eq(l.dir, dir)) { return l; } }
    let file = text.f("{s}/flint.toml", .{dir});
    let src = fs.readFile(heap.c_allocator, file) catch {
        _ = io.eprint("flint: {s}: can't read {s}\n", .{term.label("error"), file}) catch {};
        exit(1);
    };
    let pkg = alloc.new(unit.Package);
    pkg.dir = dir;
    loaded.push(pkg);
    var tp = TP { file: file, src: src, p: 0, line: 1 };
    let t = &tp;
    var table: []const u8 = "";
    var root: []const u8 = "";
    while (true) {
        skipAll(t);
        if (t.c() == 0) { break; }
        if (t.c() == '[') {
            t.p += 1;
            table = key(t);
            if (t.c() != ']') { bad(t, "expected ']' after the table name"); }
            t.p += 1;
            if (!text.eq(table, "package") && !text.eq(table, "dependencies") && !text.eq(table, "c")) {
                bad(t, text.f("unknown table [{s}] (flint.toml has [package], [dependencies] and [c])", .{table}));
            }
            continue;
        }
        let k = key(t);
        skipWs(t);
        if (t.c() != '=') { bad(t, text.f("expected '=' after '{s}'", .{k})); }
        t.p += 1;
        skipWs(t);
        let v = value(t);
        skipWs(t);
        if (t.c() != 0 && t.c() != '\n') { bad(t, text.f("expected the end of the line after the value of '{s}'", .{k})); }
        if (text.eq(table, "package")) {
            if (text.eq(k, "name")) {
                if (v.k != .Str) { bad(t, "'name' must be a string"); }
                pkg.name = v.s;
            } else if (text.eq(k, "root")) {
                if (v.k != .Str) { bad(t, "'root' must be a string"); }
                root = v.s;
            } else if (text.eq(k, "version") || text.eq(k, "description")) {
                // informational
            } else {
                bad(t, text.f("unknown key '{s}' in [package] (name, root, version, description)", .{k}));
            }
        } else if (text.eq(table, "dependencies")) {
            if (v.k != .Table) { bad(t, text.f("a dependency is an inline table: {s} = {{ path = \"../{s}\" }}", .{k, k})); }
            if (tableGet(v, "url") != null || tableGet(v, "hash") != null) {
                bad(t, text.f("dependencies fetched by url and hash aren't supported yet; use a local copy: {s} = {{ path = \"...\" }}", .{k}));
            }
            let p = tableGet(v, "path") orelse bad(t, text.f("dependency '{s}' needs a path: {s} = {{ path = \"../{s}\" }}", .{k, k, k}));
            for (pkg.deps.items) |*d| {
                if (text.eq(d.name, k)) { bad(t, text.f("dependency '{s}' is listed twice", .{k})); }
            }
            if (text.eq(k, "std")) { bad(t, "'std' is the standard library's name; pick another name for this dependency"); }
            let ddir = joinPath(dir, p);
            var probe: [1024]u8 = undefined;
            let ok = if (fs.realPath(ddir, probe[..])) |r| fs.exists(text.f("{s}/flint.toml", .{r})) else |_| false;
            if (!ok) { bad(t, text.f("dependency '{s}': no flint.toml in {s}", .{k, ddir})); }
            pkg.deps.push(unit.Dep { name: k, pkg: read(ddir) });
        } else if (text.eq(table, "c")) {
            let list = strList(t, v, k);
            let paths = text.eq(k, "sources") || text.eq(k, "include");
            var out: alloc.Vec([]const u8) = .{};
            for (list) |s| { out.push(if (paths) joinPath(dir, s) else s); }
            if (text.eq(k, "sources")) {
                pkg.csrc = out;
            } else if (text.eq(k, "include")) {
                pkg.cinc = out;
            } else if (text.eq(k, "flags")) {
                pkg.cflags = out;
            } else if (text.eq(k, "link")) {
                pkg.clink = out;
            } else {
                bad(t, text.f("unknown key '{s}' in [c] (sources, include, flags, link)", .{k}));
            }
        } else {
            bad(t, text.f("'{s}' must be inside a table, like [package]", .{k}));
        }
    }
    if (pkg.name.len == 0) {
        t.line = 1;
        bad(t, "the [package] table needs a name: name = \"...\"");
    }
    pkg.root = joinPath(dir, if (root.len > 0) root else "src/main.fl");
    if (!fs.exists(pkg.root)) {
        t.line = 1;
        bad(t, text.f("the package's root file {s} doesn't exist (set root = \"...\" in [package])", .{pkg.root}));
    }
    let slash = text.lastIndexOf(pkg.root, '/');
    pkg.rootdir = if (slash) |s| pkg.root[0..s] else pkg.root;
    return pkg;
}

// the nearest directory at or above `start` that holds a flint.toml
pub fn find(start: []const u8) -> ?[]const u8 {
    var d = start;
    while (true) {
        if (fs.exists(text.f("{s}/flint.toml", .{d}))) { return d; }
        let slash = text.lastIndexOf(d, '/') orelse return null;
        if (slash == 0) { return null; }
        d = d[0..slash];
    }
}
