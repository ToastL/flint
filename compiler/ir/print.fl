// ir.print - the human-readable dump of a module (`flint ir file.fl`).

import std.fmt;
import base.text;
import ir.ir;

let OPNAME = [_][]const u8 {
    "nop", "getarg", "iconst", "fconst", "mov",
    "add", "sub", "mul", "sdiv", "udiv", "srem", "urem", "and", "or", "xor",
    "shl", "asr", "lsr", "neg", "not",
    "fadd", "fsub", "fmul", "fdiv", "fneg", "fsqrt", "fabs",
    "cmp", "fcmp", "sel", "ext", "scvtf", "ucvtf", "fcvtzs", "fcvtzu", "fcvt",
    "load", "store", "addrslot", "addrsym", "call", "memcpy", "memzero",
    "jmp", "br", "ret", "trap",
    "smulh", "umulh", "vec", "vreduce", "asm", "asmout",
};
let VOPNAME = [_][]const u8 { "add", "sub", "mul", "div", "and", "or", "xor", "neg", "splat" };
let CCNAME = [_][]const u8 { "eq", "ne", "lt", "le", "gt", "ge", "lo", "ls", "hi", "hs", "mi", "pl" };

fn opd(o: *text.Buf, x: ir.Opd) {
    if (x.k == .Reg) { o.addf("v{}", .{x.v}); } else if (x.k == .Imm) { o.addf("#{}", .{x.v}); }
}

fn regLetter(cls: ir.Cls) -> []const u8 { return if (cls == .I) "x" else if (cls == .F32) "s" else "d"; }

fn inst(o: *text.Buf, in: *const ir.Inst) {
    o.add("    ");
    if (in.dst >= 0) { o.addf("v{} = ", .{in.dst}); }
    o.add(OPNAME[in.op as usize]);
    if (in.cls == .F32) { o.add(".s"); }
    if (in.cls == .F64) { o.add(".d"); }
    switch (in.op) {
        .IConst, .GetArg => { o.addf(" {}", .{in.imm}); }
        .AsmOut => { o.addf(" {s}{}", .{regLetter(in.cls), in.imm}); }
        .Asm => {
            o.add(" (");
            for (0..in.args.len) |k| {
                if (k > 0) { o.add(", "); }
                o.addf("{s}{} = ", .{regLetter(in.argcls[k]), in.regs[k]});
                opd(o, in.args[k]);
            }
            o.add(")");
        }
        .FConst => { o.addf(" {s}", .{text.g6(in.fimm)}); }
        .Load, .Store => {
            o.addf("{}{s} [", .{in.mem & 0x7f, if ((in.mem & 0x80) != 0) "s" else ""});
            if (in.slot >= 0) { o.addf("slot{}", .{in.slot}); } else { opd(o, in.a); }
            o.addf(" + {}]", .{in.imm});
            if (in.op == .Store) {
                o.add(", ");
                opd(o, in.b);
            }
        }
        .AddrSlot => { o.addf(" slot{}", .{in.slot}); }
        .AddrSym => { o.addf(" {s}{s}", .{in.sym, if (in.mem != 0) "@got" else ""}); }
        .Call => {
            let direct = in.sym.len > 0;
            if (direct) {
                o.addf(" {s}(", .{in.sym});
            } else {
                o.add(" *");
                opd(o, in.args[in.args.len - 1]);
                o.add("(");
            }
            let n = if (direct) in.args.len else in.args.len - 1;
            for (0..n) |k| {
                if (k > 0) { o.add(", "); }
                if (k as i32 == in.nfixed) { o.add("... "); }
                opd(o, in.args[k]);
            }
            o.add(")");
        }
        .Vec, .VReduce => {
            if (in.op == .Vec) { o.addf(".{s}", .{VOPNAME[in.mem as usize]}); }
            let es = ir.vlEsize(in.imm);
            o.addf(".{}x{}{s} ", .{ir.vlTotal(in.imm) / es, es * 8, if (ir.vlFloat(in.imm)) "f" else ""});
            opd(o, in.a);
            if (in.b.k != .None) { o.add(", "); opd(o, in.b); }
            if (in.c.k != .None) { o.add(", "); opd(o, in.c); }
        }
        .Jmp => { o.addf(" b{}", .{in.t1}); }
        .Br => {
            o.add(" ");
            opd(o, in.a);
            o.addf(", b{}, b{}", .{in.t1, in.t2});
        }
        .Cmp, .FCmp => {
            o.addf(".{s} ", .{CCNAME[in.mem as usize]});
            opd(o, in.a);
            o.add(", ");
            opd(o, in.b);
        }
        .Ext => {
            o.addf("{}{s} ", .{in.mem & 0x7f, if ((in.mem & 0x80) != 0) "s" else "u"});
            opd(o, in.a);
        }
        .Memcpy, .Memzero => {
            o.add(" ");
            opd(o, in.a);
            if (in.op == .Memcpy) {
                o.add(", ");
                opd(o, in.b);
            }
            o.addf(", {}", .{in.imm});
        }
        else => {
            if (in.a.k != .None) { o.add(" "); opd(o, in.a); }
            if (in.b.k != .None) { o.add(", "); opd(o, in.b); }
            if (in.c.k != .None) { o.add(", "); opd(o, in.c); }
        }
    }
    o.add("\n");
}

pub fn dump(m: *ir.Module, w: fmt.Writer) -> !void {
    for (m.funcs.items) |f| {
        var o: text.Buf = .{};
        o.addf("func {s} (vregs {}, slots {})\n", .{f.sym, f.vcls.items.len, f.slots.items.len});
        for (0..f.blocks.items.len) |b| {
            let blk = &f.blocks.items[b];
            if (blk.dead) { continue; }
            o.addf(" b{}:{s}\n", .{b, if (blk.cold) " (cold)" else ""});
            for (blk.insts.items) |*in| { inst(&o, in); }
        }
        o.add("\n");
        try w.writeAll(o.items);
    }
}
