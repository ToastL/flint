// Fixed arrays [N]T are values: assigning or passing one copies it.

import std.io;

let N = 4;

struct Grid {
    cells: [3][3]u8,
    name: str,
}

fn sum(xs: [4]i32) -> i32 {
    var s: i32 = 0;
    for (xs) |x| { s += x; }
    return s;
}

fn bump(xs: [4]i32) -> [4]i32 { // gets its own copy
    var ys = xs;
    for (ys) |*y| { y.* += 100; }
    return ys;
}

fn fill(p: *[N]i32, v: i32) {
    for (0..p.len) |i| { p[i] = v; }
}

fn total(xs: []const i32) -> i32 {
    var s: i32 = 0;
    for (xs) |x| { s += x; }
    return s;
}

fn main() -> !void {
    var a: [N]i32 = undefined;
    for (0..a.len) |i| { a[i] = @truncate(i32, i) + 1; }
    var b = a;                  // a copy
    b[0] = 99;
    try io.print("{} {} {} {}\n", .{ a[0], b[0], a.len, @sizeOf([4]i32) });
    try io.print("{} {} {}\n", .{ sum(a), sum(bump(a)), a[3] });

    fill(&a, 7);
    try io.print("{} {}\n", .{ a[0], a[3] });

    let all: []i32 = a[..];     // a view, not a copy
    all[1] = 8;
    let mid = a[1..3];
    try io.print("{} {} {} {} {} {}\n", .{ a[1], mid.len, mid[0], mid[1], total(&a), total(a[2..]) });

    var g = Grid { cells: undefined, name: "grid" };
    for (0..3) |r| {
        for (0..3) |c| { g.cells[r][c] = @truncate(u8, r * 3 + c); }
    }
    let h = g;                  // copies the nested array too
    g.cells[1][1] = 0;
    try io.print("{} {} {} {s}\n", .{ g.cells[2][1], g.cells[1][1], h.cells[1][1], h.name });

    var big: [100]u64 = undefined;
    for (big) |*x, i| { x.* = i * i; }
    let big2 = big;
    var t: u64 = 0;
    for (big2) |x| { t += x; }
    try io.print("{} {}\n", .{ t, big2[99] });

    let p = &a;
    try io.print("{} {}\n", .{ p.len, p[2] });
    let mp: [*]i32 = &a;
    unsafe { try io.print("{}\n", .{mp[3]}); }
    var i: usize = 0;
    while (i < 4) {
        a[i] *= 2;
        i += 1;
    }
    try io.print("{} {}\n", .{ a[0], a[3] });
}
