// Array literals live on the stack: [N]T { ... }, [_]T { ... } and @splat(v).

import std.io;

struct P { x: i32, y: i32 }

var table: [256]u8 = @splat(0); // a zeroed global
let PRIMES = 5;

fn sum3(xs: [3]f64) -> f64 { return xs[0] + xs[1] + xs[2]; }

fn main() -> !void {
    let a = [4]i32 { 1, 2, 3, 4 };
    let b = [_]u8 { 'h', 'i', '!' };
    try io.print("{} {} {} {} {}\n", .{ a.len, a[3], b.len, b[2], sum3([3]f64 { 0.5, 1, 1.5 }) });

    let pts = [_]P { P { x: 1, y: 2 }, P { x: 3, y: 4 } };
    try io.print("{}\n", .{pts[1].x + pts[0].y});

    let grid = [2][3]i32 { [3]i32 { 1, 2, 3 }, [_]i32 { 4, 5, 6 } };
    try io.print("{} {}\n", .{ grid[1][2], grid[0][1] });

    var zeros: [64]u64 = @splat(0);
    var sevens: [5]i16 = @splat(7);
    var many: [1000]f32 = @splat(0.25);
    var origin: [3]P = @splat(P { x: -1, y: 1 });
    zeros[10] = 3;
    var s: f32 = 0;
    for (many) |x| { s += x; }
    try io.print("{} {} {} {} {} {} {}\n", .{ zeros[10], zeros[63], sevens[0], sevens[4], s, origin[2].x, origin[0].y });

    let primes = [PRIMES]u32 { 2, 3, 5, 7, 11 };
    var total: u32 = 0;
    for (primes) |p, i| { total += p * @truncate(u32, i + 1); }
    try io.print("{}\n", .{total});

    table['a'] = 1;
    try io.print("{} {}\n", .{ table['a'], table['b'] });

    let view: []const u8 = &b;
    try io.print("{} {}\n", .{ view.len, view[0] });
}
