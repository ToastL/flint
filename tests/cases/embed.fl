import std.io;
import std.mem;

// @embedFile: a file's bytes, read while compiling (the path is relative to this file)
let DATA: []const u8 = @embedFile("embed_data.txt");

fn main() -> !void {
    let local = @embedFile("embed_data.txt");
    try io.print("{} bytes, same: {}\n", .{DATA.len, mem.eql(u8, DATA, local)});
    var it = mem.split(DATA, "\n");
    while (it.next()) |line| {
        if (line.len > 0) { try io.print("[{s}]\n", .{line}); }
    }
    let n = comptime countLines(@embedFile("embed_data.txt"));
    try io.print("{} lines\n", .{n});
}

fn countLines(s: []const u8) -> usize {
    var n: usize = 0;
    for (s) |c| { if (c == '\n') { n += 1; } }
    return n;
}
