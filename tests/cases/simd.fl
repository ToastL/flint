// SIMD vectors: @Vector(N, T) is one 8- or 16-byte register; each operator is one instruction

import std.io;

fn dot(a: @Vector(4, f32), b: @Vector(4, f32)) -> f32 { return @reduceAdd(a * b); }

fn squares() -> @Vector(8, i16) {
    var v: @Vector(8, i16) = @splat(-3);
    v[7] = 100;
    return v * v;
}
let SQ = comptime squares();   // vectors work at compile time too

fn main() -> !void {
    let a: @Vector(4, f32) = .{ 1, 2, 3, 4 };
    let b = a * @splat(2.0);
    try io.print("{d} {d} {d}\n", .{ @reduceAdd(b), b[3], dot(a, b) });

    var i: @Vector(4, i32) = .{ 10, -20, 30, -40 };
    i += .{ 1, 2, 3, 4 };
    let j = -i;
    try io.print("{} {} {} {}\n", .{ j[0], j[1], @reduceAdd(i), i.len });

    var u: @Vector(16, u8) = @splat(200);
    u = u + u; // vector integer math wraps: 144
    try io.print("{} {}\n", .{ u[5], @reduceAdd(u & @splat(15)) });

    let d: @Vector(2, f64) = .{ 1.5, 2.25 };
    try io.print("{d} {d}\n", .{ @reduceAdd(d / @splat(0.5)), (d - d)[1] });

    var h: @Vector(4, i16) = .{ -1, -2, -3, 4 };
    h[3] = -100;
    try io.print("{} {any}\n", .{ @reduceAdd(h), h });

    let w: @Vector(2, u64) = .{ 0xFFFFFFFFFFFFFFFF, 2 };
    try io.print("{} {any} {}\n", .{ @reduceAdd(w ^ @splat(1)), SQ, @reduceAdd(SQ) });
    for (a) |x| { try io.print("{d} ", .{x}); }
    try io.print("\n", .{});
}
