// util.strs: a nested module (util/strs.fl), imported by both main and geo
import std.mem;

pub fn shout() -> []const u8 { return "HEY"; }

pub fn countWords(s: []const u8) -> usize {
    var n: usize = 0;
    var it = mem.split(s, " ");
    while (it.next()) |w| {
        if (w.len > 0) { n += 1; }
    }
    return n;
}
