import std.ascii;
import std.fmt;
import std.heap;
import std.io;
import std.list;
import std.mem;

fn main() -> !void {
    let alloc = heap.c_allocator;
    var total: usize = 0;
    var words = list.ArrayList(str).init(alloc);
    defer words.deinit();
    var buf: [64]u8 = undefined;
    for (0..1_000_000) |i| {
        let s = try fmt.bufPrint(&buf, "item-{}: {}", .{ i, i as f64 * 0.5 });
        total += s.len;
        if (i % 100_000 == 0) { try words.append(try alloc.dupe(u8, s)); }
    }
    let joined = try mem.join(alloc, words.items, ",");
    defer alloc.free(joined);
    for (words.items) |w| { alloc.free(w); }
    var parts: usize = 0;
    var it = mem.split(joined, ",");
    while (it.next()) |_| { parts += 1; }
    let upper = try ascii.upperAlloc(alloc, joined);
    defer alloc.free(upper);
    try io.print("{} {} {}\n", .{ total, parts, mem.find(upper, "ITEM-500000") });
}
