import std.io;

struct Body { x: f64, y: f64, z: f64, vx: f64, vy: f64, vz: f64, m: f64 }

fn advance(bs: []Body, dt: f64) {
    for (0..bs.len) |i| {
        for (i + 1..bs.len) |j| {
            let dx = bs[i].x - bs[j].x;
            let dy = bs[i].y - bs[j].y;
            let dz = bs[i].z - bs[j].z;
            let d2 = dx * dx + dy * dy + dz * dz;
            let mag = dt / (d2 * sqrt(d2));
            let mj = bs[j].m * mag;
            let mi = bs[i].m * mag;
            bs[i].vx -= dx * mj;
            bs[i].vy -= dy * mj;
            bs[i].vz -= dz * mj;
            bs[j].vx += dx * mi;
            bs[j].vy += dy * mi;
            bs[j].vz += dz * mi;
        }
    }
    for (bs) |*b| {
        b.x += dt * b.vx;
        b.y += dt * b.vy;
        b.z += dt * b.vz;
    }
}

fn energy(bs: []const Body) -> f64 {
    var e: f64 = 0;
    for (bs) |b, i| {
        e += 0.5 * b.m * (b.vx * b.vx + b.vy * b.vy + b.vz * b.vz);
        for (i + 1..bs.len) |j| {
            let dx = b.x - bs[j].x;
            let dy = b.y - bs[j].y;
            let dz = b.z - bs[j].z;
            e -= b.m * bs[j].m / sqrt(dx * dx + dy * dy + dz * dz);
        }
    }
    return e;
}

fn main() -> !void {
    let PI = 3.141592653589793;
    let SOLAR = 4.0 * PI * PI;
    let DPY = 365.24;
    var bodies = [_]Body {
        Body { x: 0, y: 0, z: 0, vx: 0, vy: 0, vz: 0, m: SOLAR },
        Body { x: 4.84143144246472090e+00, y: -1.16032004402742839e+00, z: -1.03622044471123109e-01,
               vx: 1.66007664274403694e-03 * DPY, vy: 7.69901118419740425e-03 * DPY, vz: -6.90460016972063023e-05 * DPY,
               m: 9.54791938424326609e-04 * SOLAR },
        Body { x: 8.34336671824457987e+00, y: 4.12479856412430479e+00, z: -4.03523417114321381e-01,
               vx: -2.76742510726862411e-03 * DPY, vy: 4.99852801234917238e-03 * DPY, vz: 2.30417297573763929e-05 * DPY,
               m: 2.85885980666130812e-04 * SOLAR },
        Body { x: 1.28943695621391310e+01, y: -1.51111514016986312e+01, z: -2.23307578892655734e-01,
               vx: 2.96460137564761618e-03 * DPY, vy: 2.37847173959480950e-03 * DPY, vz: -2.96589568540237556e-05 * DPY,
               m: 4.36624404335156298e-05 * SOLAR },
        Body { x: 1.53796971148509165e+01, y: -2.59193146099879641e+01, z: 1.79258772950371181e-01,
               vx: 2.68067772490389322e-03 * DPY, vy: 1.62824170038242295e-03 * DPY, vz: -9.51592254519715870e-05 * DPY,
               m: 5.15138902046611451e-05 * SOLAR },
    };
    let bs: []Body = &bodies;
    var px: f64 = 0;
    var py: f64 = 0;
    var pz: f64 = 0;
    for (bs) |b| {
        px += b.vx * b.m;
        py += b.vy * b.m;
        pz += b.vz * b.m;
    }
    bs[0].vx = -px / SOLAR;
    bs[0].vy = -py / SOLAR;
    bs[0].vz = -pz / SOLAR;
    try io.print("{}\n", .{energy(bs)});
    for (0..20_000_000) |step| { advance(bs, 0.01); }
    try io.print("{}\n", .{energy(bs)});
}
